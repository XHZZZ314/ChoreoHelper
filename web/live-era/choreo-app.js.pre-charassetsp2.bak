// 编舞助手主页控制器：负责 DOM 渲染与业务模块编排，保持 file:// 经典脚本兼容。
'use strict';
// 48794 基址与请求出口归 choreo-api.js（ARCH-2 配对客户端）；本文件只留 apiFetch/apiPreview 薄壳
var CHOREO_PROTOCOL=1; // v0.6.7 协议版本：与插件 /capabilities.protocolVersion 对比，不匹配提示升级
var LABEL_W=112; // 时间轴标签列宽(px)：须与 .lane-label 的 CSS 宽度一致（普通 112 / body.narrow 64），applyCompact 里随模式切换（AUD3-W2）

var dancerColors=['#7eb3ff','#e07bf5','#5dde8e'];
var store={
  connected:false,pps:60,snapEnabled:true,snapGrid:1.0,snapThreshold:0.3,currentTime:0,isPlaying:false,speed:1,totalDuration:300,measuredDur:{},
  // 阶段1（模式分流）：连接状态与工作模式拆开——connected 只代表 48794 在线（旧 UI 圆点还在用，保留为镜像）
  appReady:false,          // 网页程序就绪：编辑器能不能渲染只看它，跟游戏连不连无关
  gameConnected:false,     // 48794 游戏插件在线
  exportConnected:false,   // 48795 导出/3D 服务在线
  // v0.6.7（安全与能力握手）：capsOk=插件 ≥0.6.7（支持 /capabilities 与配对）；
  // 旧插件走兼容模式——写请求不带配对头（旧插件的预检靠业务响应带 CORS 头过关，多一个
  // 自定义头反而会让预检失败），所以配对头只在 capsOk 时才发
  capsOk:false,
  pluginCaps:null,
  pairToken:(function(){try{return localStorage.getItem('choreo_pairToken')||''}catch(e){return ''}})(),
  previewTarget:(function(){try{return localStorage.getItem('choreo_previewTarget')==='game'?'game':'web'}catch(e){return 'web'}})(),
  // ACTOR（2026-08-31）：游戏预览舞者（舞者下标，仅游戏模式消费；网页排练仍是多舞者口径）。
  // 游戏内只有一位本地角色，播放/拖动只演这一位，防止多家事件混在同一个角色上
  gameActor:(function(){try{var v=parseInt(localStorage.getItem('choreo_gameActor'),10);return v>=0?v:0}catch(e){return 0}})(),
  catalogFromSnapshot:false, // 阶段2：当前侧栏目录来自内置快照（游戏连上后会被线上目录覆盖）
  // 实时体检（瞬态，不进项目存储）：最近一次体检结果 + clipId→最严重级别（渲染描边用）
  checkIssues:[],checkLevel:{},
  // 目录数组必须先给空值：阶段1起 render() 先于插件目录加载执行，undefined 会让侧栏 .filter 崩掉
  emotes:[],races:[],actions:[],classJobs:[],
  gpose:false,
  engine:(function(){try{return localStorage.getItem('choreo_engine')||'classic'}catch(e){return 'classic'}})(),
  compact:(function(){try{var v=localStorage.getItem('choreo_compact');if(v!==null)return v===('1');return window.innerWidth<=980}catch(e){return window.innerWidth<=980}})(),
  jobMap:{},
  dancers:[],dancerCount:1,
  globalLyrics:[],showLyricMacro:false,
  // WP-3（项目中心）：当前项目身份。存储在 choreo-projects.js（IndexedDB choreo3dproj +
  // localStorage 镜像 choreo_autosave）；上面 dancers 等 5 个字段就是项目 content，格式没变
  projectId:null,projectName:'',projectCreatedAt:0,projectsDegraded:false,
  // WP-5-WIRE（2026-08-31）：持久化接线载体（转换逻辑在 choreo-docwire.js，node 单测覆盖）
  // contentExtra=投影顶层的未知键（保存时原样回文档 _extra，修掉固定字段清单丢键）；
  // _docRev=持久文档的 timelineRevision（装载播种、编辑递增，与游戏协议的 _tlRevision 分层）
  contentExtra:{},_docRev:1,
  selectedClip:null,selectedDancer:0,
  // WP-3b（编辑基础）：都是会话级状态，不进项目文件——loopA/B 是网页播放的循环区间；
  // markers 是段落标记的内存镜像（真身随项目 content 持久化）；_clipboard 是编辑剪贴板
  loopA:null,loopB:null,markers:[],_clipboard:null,
  activeTab:'emote-usual',search:'',
  addToAll:false, // MULTI-DANCER：添加到全部舞者（会话级开关，不进项目文件）
  history:[],historyIdx:-1,nextClipId:1,
  macroCollapsed:false,activeMacroTab:0,
  dancerHeights:{} // di -> lane height multiplier
};

function fmtTime(t){var m=Math.floor(t/60),s=t%60;return String(m).padStart(2,'0')+':'+s.toFixed(1).padStart(4,'0')}
function updateTimeDisplay(){var e=document.getElementById('timeDisplay');if(e)e.textContent=fmtTime(store.currentTime);var e2=document.getElementById('cursorPos');if(e2)e2.textContent='位置: '+store.currentTime.toFixed(1)+'s'}
function snapTime(t,clip,di,tt,type){
  if(!store.snapEnabled)return t;
  var snap=store.snapThreshold;
  var candidates=[];
  // Grid snap (whole seconds)
  // HYGIENE(AC-5)：网格候选只搜到 300s（i<=300）——超过 300s 的时刻只剩其他条目边缘可吸附，
  // 这是既有行为（配合轨道默认 300s 总长），列为开放契约，行为修正需另行立项
  for(var i=0;i<=300;i+=0.5){candidates.push(i)}
  // Snap to other clips' start/end in same dancer
  if(di>=0&&store.dancers[di]){
    var d=store.dancers[di];
    ['switchClips','actionClips','lyricClips'].forEach(function(k){
      d[k].forEach(function(c){
        if(c.id===clip.id)return;
        candidates.push(c.start,c.start+c.duration);
      });
    });
  }
  // Also snap to global lyrics
  store.globalLyrics.forEach(function(c){if(c.id!==clip.id)candidates.push(c.start,c.start+c.duration)});
  // Find closest candidate
  var best=t,bestDist=snap;
  candidates.forEach(function(c){var d=Math.abs(c-t);if(d<bestDist){bestDist=d;best=c}});
  return best;
}
function fmtDur(t){if(t<60)return Math.round(t)+'s';return Math.floor(t/60)+'m'+Math.floor(t%60)+'s'}
// AUD-002：el() 只收纯文本（textContent）——动作名/台词/歌词/标记名等项目内容一律按文本节点渲染；
// 需要拼结构化 HTML 的地方必须用 DOM API 组装（appendChild + el 子节点），禁止把用户可控字符串拼进 innerHTML
function el(tag,cls,text){var e=document.createElement(tag);if(cls)e.className=cls;if(text!==undefined)e.textContent=text;return e}
function showToast(msg){var t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(t._t);t._t=setTimeout(function(){t.classList.remove('show')},2000)}
function showTip(x,y,text){var t=document.getElementById('tooltip');t.textContent=text;t.style.left=x+'px';t.style.top=y+'px';t.classList.add('show')}
function hideTip(){document.getElementById('tooltip').classList.remove('show')}
function setLoadingText(t){document.getElementById('loadTx').textContent=t}

function saveHistory(){
  // WP-3b：快照扩到 markers（段落标记的增删改也要能撤销）；dancers 快照天然带上 solo/mute
  // AUD-005：showLyricMacro 也是可撤销编辑（onchange 会进历史），一并入快照；
  // totalDuration 是派生值不入快照，恢复时统一重算
  var s=JSON.parse(JSON.stringify({dancers:store.dancers,globalLyrics:store.globalLyrics,markers:store.markers,showLyricMacro:store.showLyricMacro}));
  store.history=store.history.slice(0,store.historyIdx+1);
  store.history.push(s);store.historyIdx++;
  if(store.history.length>50){store.history.shift();store.historyIdx--}
  persistProject(); // WP-3：不再直接写 choreo_draft，改走项目存储层（镜像同步 + IndexedDB）
  bumpTimelineRev(); // FIX-B：内容变了，游戏时间轴快照要跟着重推
}
// === WP-3（项目中心）：项目持久化与当前项目记录 ===
// WP-5-WIRE：content 存的就是规范演出文档——6 已知字段 + contentExtra 未知键一起经文档模块
// 迁移（未知键收进 _extra，修掉固定字段清单丢键）；timelineRevision 写携带的 _docRev
function projectRecord(){
  var proj={dancers:store.dancers,globalLyrics:store.globalLyrics,dancerCount:store.dancerCount,showLyricMacro:store.showLyricMacro,totalDuration:store.totalDuration,markers:store.markers};
  var extra=store.contentExtra;
  if(extra)Object.keys(extra).forEach(function(k){proj[k]=extra[k]});
  return {id:store.projectId,name:store.projectName,createdAt:store.projectCreatedAt||Date.now(),updatedAt:Date.now(),
    schemaVersion:(window.ChoreoProjects&&ChoreoProjects.pure.SCHEMA_VERSION)||2,
    content:ChoreoDocWire.persistDoc(proj,{id:store.projectId,name:store.projectName},store._docRev)};
}
var _lastSnapAt=0,_lastSnapJson='';
function persistProject(){
  if(!window.ChoreoProjects||!store.projectId)return;
  var rec=projectRecord();
  ChoreoProjects.saveActive(rec); // 镜像同步落盘（崩溃保险）+ IndexedDB
  try{ // 每 5 分钟（有改动时）自动存一个历史版本快照
    var j=JSON.stringify(rec.content);
    if(Date.now()-_lastSnapAt>5*60*1000&&j!==_lastSnapJson){
      _lastSnapAt=Date.now();_lastSnapJson=j;
      ChoreoProjects.addVersion(rec.id,'自动保存',rec.content,true);
    }
  }catch(e){}
}
function undo(){
  if(store.historyIdx<=0)return;
  store.historyIdx--;
  var s=JSON.parse(JSON.stringify(store.history[store.historyIdx]));
  store.dancers=s.dancers||[];store.globalLyrics=s.globalLyrics||[];store.markers=s.markers||[];
  store.showLyricMacro=!!s.showLyricMacro; // AUD-005：歌词宏显示跟快照走
  store.dancerCount=store.dancers.length;
  store.selectedClip=null;
  updateTotalDuration(); // AUD-005：派生值恢复后重算，不残留旧时长
  render();
  persistProject(); // AUD-005：撤销结果立即落盘（不调 saveHistory，避免破坏撤销栈）——撤销后直接关页面重开也是撤销后的状态
  bumpTimelineRev(); // FIX-B：撤销也是内容变化
}
function redo(){ // WP-3：重做。撤销栈本来就是“截断重写”式（saveHistory 里 slice），历史点之后还有记录就能重做
  if(store.historyIdx>=store.history.length-1)return;
  store.historyIdx++;
  var s=JSON.parse(JSON.stringify(store.history[store.historyIdx]));
  store.dancers=s.dancers||[];store.globalLyrics=s.globalLyrics||[];store.markers=s.markers||[];
  store.showLyricMacro=!!s.showLyricMacro;
  store.dancerCount=store.dancers.length;
  store.selectedClip=null;
  updateTotalDuration();
  render();
  persistProject(); // AUD-005：同 undo
  bumpTimelineRev(); // FIX-B：重做也是内容变化
}

// Emote categorization
var exprNames={'blink':1,'wink':1,'kiss':1,'fume':1,'pout':1,'tongue':1,'facepalm':1,'sigh':1,'snicker':1,'blush':1,'smug':1,'sneer':1,'provoke':1,'bored':1,'sleepy':1};
var specNames={'dance':1,'sit':1,'pose':1,'stretch':1,'cross':1,'beckon':1};
function categorizeEmote(name,gc){
  var l=name?name.toLowerCase():'';
  if(gc){
    var gl=gc.toLowerCase();
    if(gl.indexOf('usual')>=0||gc.indexOf('\u901A\u5E38')>=0)return'usual';
    if(gl.indexOf('special')>=0||gc.indexOf('\u7279\u6B8A')>=0||gc.indexOf('\u7279\u522B')>=0)return'special';
    if(gl.indexOf('expression')>=0||gc.indexOf('\u8868\u60C5')>=0||gl.indexOf('expr')>=0)return'expression';
  }
  if(exprNames[l]||exprNames[name])return'expression';
  if(specNames[l]||specNames[name])return'special';
  return'usual';
}

// LRC parser
function parseLRC(text){
  var lines=[];
  text.split('\n').forEach(function(line){
    var re=/\[(\d{1,3}):(\d{1,2})(?:[.:](\d{1,3}))?\]/g,m,times=[];
    while(m=re.exec(line)){times.push(m[1]*60+ +m[2]+(m[3]?+m[3].padEnd(3,'0'):0)/1000)}
    var txt=line.replace(/\[\d{1,3}:\d{1,2}(?:[.:]\d{1,3})?\]/g,'').trim();
    times.forEach(function(t){if(txt)lines.push({time:t,text:txt})})
  });
  lines.sort(function(a,b){return a.time-b.time});
  // 双语歌词合并：同刻（<0.05s）的后续行视为翻译，并为一行 "原文 / 译文"
  // （网易云导出的双语 LRC / 手动拼接的原文+翻译都是同时间戳成对出现）
  var merged=[];
  lines.forEach(function(l){
    var prev=merged[merged.length-1];
    if(prev&&Math.abs(l.time-prev.time)<0.05){
      if(prev.text.indexOf(l.text)<0)prev.text=prev.text+' / '+l.text;
    }else merged.push({time:l.time,text:l.text});
  });
  return merged
}
// 旧骨骼录制进度轮询 startRecPoll 已删：唯一数据源 /bonerec/status 随 BoneAnimator 死臂
// 删除（恒回 {}），且本函数无任何调用方。底栏 recPos 显示位保留——录制中心
// （choreo-recording-ui.js recPosText）用它展示每条/整场录制结果
// v0.6.7 配对帮手：新版插件（capsOk）的写请求统一带 X-Choreo-Token；配对码存 localStorage 一个浏览器只粘一次
// normToken：全角→半角、去空白、转大写——主人实测中文输入法全角状态粘码会校验必挂，
// 且非 ASCII 值进 HTTP 头会让 fetch 直接抛 TypeError（请求根本发不出去），所以存之前就归一
function normToken(t){
  return String(t||'').replace(/\u3000/g,' ')
    .replace(/[\uFF01-\uFF5E]/g,function(ch){return String.fromCharCode(ch.charCodeAt(0)-0xFEE0)})
    .replace(/\s+/g,'').toUpperCase();
}
function choreoTokenHeaders(extra){
  var h=extra||{};
  // 只带可见 ASCII 的 token（双保险：normalize 后仍异常的值不发，避免 fetch 抛错）
  if(store.capsOk&&store.pairToken&&/^[\x21-\x7E]+$/.test(store.pairToken))h['X-Choreo-Token']=store.pairToken;
  return h;
}
function savePairToken(t){
  store.pairToken=normToken(t);
  try{
    if(store.pairToken)localStorage.setItem('choreo_pairToken',store.pairToken);
    else localStorage.removeItem('choreo_pairToken');
  }catch(e){}
  // SEC-1：/export/list 是私有读——没配对时导出连接指示如实显示未连接；
  // 主人粘贴/更换配对码后立即重探一次，指示不用等 15 秒的连接监视器
  if(store.appReady)probeExport();
}
// 403 = 插件说"要配对"：指路 toast（15 秒节流，别让循环调用刷屏）
function handle403(){
  if(store._pairToastAt&&Date.now()-store._pairToastAt<15000)return;
  store._pairToastAt=Date.now();
  showToast('需要配对：游戏里输入 /choreo pair 查看配对码，到「⋯ 高级 → 网页配对」粘贴一次');
}
// ARCH-2：apiFetch/apiPreview 语义整体搬进 choreo-api.js（game 客户端）——统一配对码头、
// 4 秒超时、403 配对提示、非 2xx 中文 detail（e.status/e.detail）与 2xx JSON 解析都在那一侧；
// 这里保留全局薄壳，全部既有调用方（含 clip-check 在 apiFetch 层的拦截桩）不用改
function apiFetch(path,opts){return ChoreoAPI.game.api(path,opts)}
function apiPreview(cmd){return ChoreoAPI.game.preview(cmd)}
// 配对码与 403 提示仍归主页状态（store/localStorage/toast），经注入进入客户端——
// 客户端自身零 DOM/localStorage 访问
ChoreoAPI.setTokenProvider(function(){return choreoTokenHeaders()});
ChoreoAPI.setPairingHandler(handle403);

var switchItems=[];
for(var i=1;i<=15;i++)switchItems.push({id:'gs'+i,name:'\u5207\u6362'+i,command:'/gs change '+i,category:'switch'});

// Job role colors
var roleColors={0:'#22d3ee',1:'#4d7eff',2:'#ff5757',3:'#e07bf5',4:'#5dde8e'};
var SWITCH_CAT='switch';

// ===== 分屏紧凑模式（收起侧栏为浮窗 + 全面紧凑化）=====
var _compactTouched=false,_sideOpen=false;
function applyCompact(){document.body.classList.toggle('narrow',!!store.compact);LABEL_W=store.compact?64:112;if(!store.compact)closeSidebar()}
function openSidebar(){var sb=document.querySelector('.sidebar');if(sb)sb.classList.add('open');var bd=document.getElementById('sbBackdrop');if(bd)bd.classList.add('show');_sideOpen=true}
function closeSidebar(){_sideOpen=false;var sb=document.querySelector('.sidebar');if(sb)sb.classList.remove('open');var bd=document.getElementById('sbBackdrop');if(bd)bd.classList.remove('show')}
function toggleSidebar(){if(document.body.classList.contains('narrow')){_sideOpen?closeSidebar():openSidebar()}else{document.body.classList.toggle('wide-nosb')}}
function _applySideOpen(){if(_sideOpen&&store.compact){var sb=document.querySelector('.sidebar');if(sb&&!sb.classList.contains('open'))sb.classList.add('open');var bd=document.getElementById('sbBackdrop');if(bd)bd.classList.add('show')}}
window.addEventListener('resize',function(){if(_compactTouched)return;var nc=window.innerWidth<=980;if(nc!==!!store.compact){store.compact=nc;applyCompact();if(store.appReady)render()}});

// seek 合并+串行:同一时刻只有一个请求在途,拖动中新位置覆盖旧位置(拖动器自身有50ms节流,
// 见下方 onMove 的 now-lastSent>50 门槛——旧注释写 150ms 与实现不符,HYGIENE(AC-5) 纠正)
// 阶段1（模式分流）：网页 3D 模式下拖动只走本地（preview3d 自己读 store.currentTime），不向游戏发 seek/freeze
// FIX-B（AUD2-003）：seek 带 revision（时间轴修订号）；插件版本不符回 409，网页重推快照后重试一次
// WEB-RACE：每次 seek 带递增序号，重试资格只属于最新意图——排队里的新时间优先于旧时间的 409 重试
var _seekBusy=false,_seekPending=null,_seekSeq=0;
function sendSeek(t,noRetry){
  if(store.previewTarget!=='game')return;
  var seq=++_seekSeq;
  if(_seekBusy){_seekPending={t:t,seq:seq};return}
  _seekBusy=true;
  var payload={time:Math.round(t*100)/100,revision:store._tlRevision};
  apiFetch('/playback/seek',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
  .then(function(){
    _seekBusy=false;
    if(_seekPending){var p=_seekPending;_seekPending=null;sendSeek(p.t)}
  },function(e){
    _seekBusy=false;
    if(e&&e.status===409&&!noRetry){
      // 插件持有旧时间轴 → 重推快照后重试一次（只重试一次防循环）。
      // 排队里有更新的 seek 就让它接管重推后的落位（它自己带 409 重试资格），旧时间不得压过它
      pushGameTimeline(true).then(function(){
        if(_seekPending){var p=_seekPending;_seekPending=null;sendSeek(p.t)}
        else if(seq===_seekSeq){sendSeek(t,true)}
      });
      return;
    }
    if(_seekPending){var p=_seekPending;_seekPending=null;sendSeek(p.t)}
  });
}

// === FIX-B（AUD2-003）：时间轴修订号 + 快照同步 ===
// 每次内容变化（编辑/撤销/重做/换项目/导入）递增 revision；游戏模式下防抖 300ms 把
// buildGameClips 规范快照推给插件 /playback/timeline 原子替换。这样「切到游戏模式后
// 未按播放就拖动」「编辑后未重新播放就拖动」都作用在当前时间轴上，不再拿空/旧时间轴。
store._tlRevision=1;
var _tlPushTimer=null;
function bumpTimelineRev(){
  store._tlRevision++;
  store._docRev=(store._docRev||0)+1; // WP-5-WIRE：持久文档的 timelineRevision 跟内容变化一起走
  if(store.previewTarget==='game'&&store.gameConnected&&!store.isPlaying){
    if(_tlPushTimer)clearTimeout(_tlPushTimer);
    _tlPushTimer=setTimeout(pushGameTimeline,300);
  }
}
function pushGameTimeline(force){
  if(_tlPushTimer){clearTimeout(_tlPushTimer);_tlPushTimer=null}
  if(store.previewTarget!=='game'||!store.gameConnected)return Promise.resolve(false);
  if(store.isPlaying&&!force)return Promise.resolve(false); // 播放中插件时间轴由 start 负责
  var rev=store._tlRevision;
  var clips=buildGamePayloadClips();
  return apiFetch('/playback/timeline',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({clips:clips,revision:rev})})
    .then(function(d){return !!(d&&d.status==='ok')})
    .catch(function(){return false});
}

// === ACTOR（2026-08-31）：游戏预览舞者 ===
// 当前产品游戏内只有一个本地角色：游戏模式的播放/拖动只演这一位，绝不把多个舞者的事件
// 混到同一角色上（插件侧 PreviewActorPolicy 也会拒绝混演员 payload）。网页排练
// （3D 预览/独奏/静音/A-B 循环）保持多舞者口径不变；显式选中的预览舞者不受静音影响。
function gameActorIdx(){
  if(!store.dancers.length)return -1;
  return (store.gameActor>=0&&store.gameActor<store.dancers.length)?store.gameActor:0;
}
function setGameActor(di){
  if(store.gameActor===di)return;
  store.gameActor=di;
  try{localStorage.setItem('choreo_gameActor',String(di))}catch(e){}
  render();
  if(store.previewTarget==='game'&&store.gameConnected&&!store.isPlaying){
    // 立即换人：新舞者时间轴推给插件，并按当前播放头重新定格（游戏里马上看到换了谁）
    pushGameTimeline(true).then(function(ok){if(ok)sendSeek(store.currentTime)});
  }
}
function buildGamePayloadClips(){
  return ChoreoEdit.pure.buildGameClips(store.dancers,store.globalLyrics,null,gameActorIdx());
}

// v0.5.21: 修复存量数据的英文 clip 名 —— 旧版宏解析回填时直接拿命令去斜杠当名字（/bow->"bow"），
// 已保存进草稿。按命令回查表情表恢复中文名；解析默认的 expression 分类也一并还原真实分类。
function repairClipNames(){
  if(!store.emotes||!store.emotes.length)return;
  var byCmd={};
  store.emotes.forEach(function(e2){var c=(e2.command||'').toLowerCase();if(c&&c.indexOf(' ')<0&&!byCmd[c])byCmd[c]={name:e2.name,category:e2.category}});
  store.dancers.forEach(function(d){
    (d.actionClips||[]).forEach(function(c){
      // 剥掉变体后缀再查（"/bow motion" -> 查 "/bow"），命令本身保持不变
      var key=(c.data.command||'').toLowerCase().replace(/\s+(motion|loop|special)\s*$/,'');
      var m=byCmd[key];
      if(m){c.data.name=m.name;if(c.data.category==='expression')c.data.category=m.category}
    });
  });
}
// === WP-3（项目中心）：从项目存储层恢复，替代旧的 restoreDraft（直读 choreo_draft） ===
function recalcNextClipId(){
  var maxId=0;
  store.dancers.forEach(function(d){['switchClips','actionClips','lyricClips'].forEach(function(k){(d[k]||[]).forEach(function(c){if(c.id>maxId)maxId=c.id})})});
  store.globalLyrics.forEach(function(c){if(c.id>maxId)maxId=c.id});
  store.nextClipId=maxId+1;
}
function clearClipSelection(){ // 清掉所有选中标记（切换项目/导入工程后旧引用必须作废）
  store.dancers.forEach(function(d){['switchClips','actionClips','lyricClips'].forEach(function(k){(d[k]||[]).forEach(function(c){c.selected=false})})});
  store.globalLyrics.forEach(function(c){c.selected=false});
  store.selectedClip=null;
}

// ============ WP-3b：时间轴编辑基础（多选/复制粘贴/批量/插入删除时间/A-B/标记/独奏静音） ============
// 纯数据操作都在 choreo-edit.js 的 ChoreoEdit.pure（node 单测 test-edit.js 覆盖）；这里只做接线
function edContent(){return {dancers:store.dancers,globalLyrics:store.globalLyrics,markers:store.markers}}
function edSel(){return ChoreoEdit.pure.collectSelected(edContent())}
function edHasSel(){return edSel().length>0}
function edSelectAll(){ChoreoEdit.pure.selectAll(edContent());render()}
function edIsMuted(di){return ChoreoEdit.pure.isMuted(store.dancers,di)}
function edHasLoop(){return store.loopA!=null&&store.loopB!=null&&(store.loopB-store.loopA)>=0.5}

function deleteSelectedClips(){ // Delete 键与「删除所选」共用：多选整批删，单选走原逻辑
  var sel=edSel();
  if(sel.length<=1){
    // AUD3-W3（FIX-H）：Ctrl+点A、点B、再点B 后，A 仍 selected=true 但 selectedClip 已置 null——
    // 此时 Delete 会静默失效；回退到选集里剩的那条
    var one=store.selectedClip||(sel[0]&&sel[0].clip);
    if(!one)return;
    var nm=one.data&&one.data.name;
    deleteClip(one.id);
    showToast('已删除: '+(nm||'clip'));
    return;
  }
  var ids={};sel.forEach(function(s){ids[s.clip.id]=true});
  store.dancers.forEach(function(d){['switchClips','actionClips','lyricClips'].forEach(function(k){d[k]=d[k].filter(function(c){return !ids[c.id]})})});
  store.globalLyrics=store.globalLyrics.filter(function(c){return !ids[c.id]});
  store.selectedClip=null;
  saveHistory();updateTotalDuration();render();
  showToast('已删除 '+sel.length+' 条');
}
function copySelection(){ // Ctrl+C：序列化选中到会话剪贴板（跨粘贴保持相对间距与舞者/轨归属）
  var sel=edSel();
  if(!sel.length){showToast('先选中动作条：单击选中、Ctrl+点击加选、空白处拖动框选');return}
  store._clipboard=ChoreoEdit.pure.serializeSelection(sel);
  showToast('已复制 '+store._clipboard.items.length+' 条');
}
function pasteSelection(){ // Ctrl+V / 右键「粘贴到选中条后」：紧贴当前选中的那条之后粘贴（2026-08-29 主人拍板）；
  // 没有选中条时退回旧的"粘贴到播放头"语义。腾位逻辑照旧：重叠的条目自动右移，粘贴后零重叠
  if(!store._clipboard||!store._clipboard.items.length){showToast('剪贴板是空的');return}
  var anchor=store.selectedClip;
  var t=anchor?(anchor.start+anchor.duration):store.currentTime;
  var created=ChoreoEdit.pure.pasteItems(store._clipboard,edContent(),t,function(){return store.nextClipId++});
  if(!created.length){showToast('粘贴目标舞者不存在（舞者数被减少？）');return}
  clearClipSelection();
  created.forEach(function(c){c.selected=true});
  store.selectedClip=created[created.length-1];
  saveHistory();updateTotalDuration();render();
  showToast(anchor
    ?('已粘贴 '+created.length+' 条紧贴「'+(anchor.data&&anchor.data.name||'clip')+'」之后（重叠的条目已自动右移）')
    :('已粘贴 '+created.length+' 条到播放头 '+store.currentTime.toFixed(1)+'s（重叠的条目已自动右移让位）'));
}
function alignSelectionToPlayhead(){ // 右键「对齐到播放头」：选中条起点统一=播放头（跨舞者齐奏入口）
  var sel=edSel();if(!sel.length)return;
  ChoreoEdit.pure.alignStarts(sel,store.currentTime);
  saveHistory();updateTotalDuration();render();
  showToast('已把 '+sel.length+' 条的起点对齐到 '+store.currentTime.toFixed(1)+'s');
}
function insDelTime(ins){ // 「⋯ 高级」里的插入/删除时间：作用全体舞者+全局歌词+段落标记
  var v=prompt((ins?'在播放头插入的时长':'要删除的时长')+'（秒，0.5 步进，影响全部舞者和全局歌词）：','2');
  if(v===null)return;
  var sec=ChoreoEdit.pure.q05(parseFloat(v));
  if(!(sec>=0.5)){showToast('请输入 ≥0.5 的秒数');return}
  if(ins){
    ChoreoEdit.pure.insertTime(edContent(),store.currentTime,sec);
    store.loopA=store.loopB=null; // 时间轴变了，循环区间作废
    saveHistory();updateTotalDuration();render();
    showToast('已在 '+store.currentTime.toFixed(1)+'s 插入 '+sec+'s，后面的条目整体右移');
  }else{
    var t0=store.currentTime,t1=t0+sec;
    var r=ChoreoEdit.pure.deleteTime(edContent(),t0,t1);
    store.loopA=store.loopB=null;
    if(store.currentTime>=t1)store.currentTime-=sec;else if(store.currentTime>t0)store.currentTime=t0;
    store.totalDuration=Math.max(300,store.totalDuration-sec);
    saveHistory();render();
    showToast('已删除 '+t0.toFixed(1)+'~'+t1.toFixed(1)+'s（移除 '+r.removed+' 条，后面的整体左移）');
  }
}
function setLoopPoint(which){ // 传输区 A/B 按钮：在播放头设循环区间（仅网页播放；游戏模式按钮禁用）
  if(store.previewTarget==='game'){showToast('A-B 循环只支持网页播放——游戏插件没有循环端点');return}
  store[which]=store.currentTime;
  if(store.loopA!=null&&store.loopB!=null&&store.loopB<store.loopA){var t=store.loopA;store.loopA=store.loopB;store.loopB=t}
  render();
  showToast(which==='loopA'?('A='+store.loopA.toFixed(1)+'s'+(store.loopB!=null?' · B='+store.loopB.toFixed(1)+'s':'（再按 B 设终点）')):('B='+store.loopB.toFixed(1)+'s · A='+store.loopA.toFixed(1)+'s'));
}
function clearLoop(){store.loopA=store.loopB=null;render();showToast('已清除 A-B 循环')}
function addMarkerAtPlayhead(){ // 传输区 ⚑ 按钮：在播放头加段落标记（随项目保存、可撤销）
  var mk=ChoreoEdit.pure.addMarker(store.markers,store.currentTime,'段落'+(store.markers.length+1),ChoreoEdit.pure.newMarkerId());
  saveHistory();render();
  showToast('已加标记「'+mk.name+'」@'+mk.t.toFixed(1)+'s（标尺上点击跳转、右键改名/删除）');
}
function showMarkerMenu(x,y,mk){ // 标尺旗标右键菜单（复用 #ctxMenu 容器）
  var m=document.getElementById('ctxMenu');m.innerHTML='';
  [['✎ 改名',function(){var v=prompt('标记名称：',mk.name||'');if(v===null)return;mk.name=v.trim()||mk.name;ChoreoEdit.pure.sortMarkers(store.markers);saveHistory();render()}],
   ['⏱ 改时间',function(){var v=prompt('标记时间（秒）：',String(mk.t));if(v===null)return;var t2=parseFloat(v);if(!(t2>=0)){showToast('时间无效');return}ChoreoEdit.pure.updateMarker(store.markers,mk.id,{t:t2});saveHistory();render()}],
   ['🗑 删除本标记',function(){ChoreoEdit.pure.removeMarker(store.markers,mk.id);saveHistory();render();showToast('已删除标记')}],
   ['🗑 删除全部标记',function(){if(!confirm('删除全部段落标记？'))return;store.markers=[];saveHistory();render()},true]
  ].forEach(function(pair){
    var mi=el('div','ctx-it'+(pair[2]?' danger':''),pair[0]);
    mi.onclick=function(){pair[1]();m.classList.remove('show')};
    m.appendChild(mi);
  });
  m.style.left=x+'px';m.style.top=y+'px';m.classList.add('show');
}
function applyProjectContent(ct){
  // WP-5-WIRE：装载一律过文档模块——规范文档/WP-3 旧内容自动识别迁移，投影回 store；
  // 未知顶层键收进 store.contentExtra，保存时原样回文档 _extra（不再被固定字段清单丢弃）
  var w=ChoreoDocWire.loadProjection(ct);
  var proj=w.proj;
  if(window.ChoreoProjects&&ChoreoProjects.pure&&ChoreoProjects.pure.normalizeContent)ChoreoProjects.pure.normalizeContent(proj);
  if(w.warning)showToast('项目数据格式异常，已按空项目打开：'+w.warning);
  store.dancers=proj.dancers||[];
  store.globalLyrics=proj.globalLyrics||[];
  if(proj.totalDuration&&proj.totalDuration>=300)store.totalDuration=proj.totalDuration; // 手动加长的轨道长度跨会话保留
  store.dancerCount=proj.dancerCount||Math.max(1,store.dancers.length);
  store.showLyricMacro=!!proj.showLyricMacro;
  store.markers=proj.markers||[];
  store.contentExtra=ChoreoDocWire.unknownTopKeys(proj);
  recalcNextClipId();
  bumpTimelineRev(); // FIX-B：换项目/导入/恢复后内容整体变了，游戏时间轴快照作废重推
  store._docRev=w.rev; // WP-5-WIRE：装载本身不推进持久修订号——种子在 bump 之后重写，下一条编辑才 +1
}
async function loadActiveProject(){
  var res={degraded:false,migrated:false,name:''};
  try{res=await ChoreoProjects.init()}
  catch(e){res={degraded:true,migrated:false,name:''}}
  store.projectsDegraded=!!res.degraded;
  var rec=null,recovered=false;
  try{
    var opened=await ChoreoProjects.openProject(ChoreoProjects.getActiveId());
    if(opened&&opened.record){rec=opened.record;recovered=!!opened.recovered}
  }catch(e){}
  if(!rec)rec=ChoreoProjects.pure.defaultRecord();
  store.projectId=rec.id;store.projectName=rec.name||'我的编舞';store.projectCreatedAt=rec.createdAt||Date.now();
  applyProjectContent(rec.content||{});
  try{_lastSnapAt=Date.now();_lastSnapJson=JSON.stringify(projectRecord().content)}catch(e){} // 打开时定基线（WP-5-WIRE：按迁移后的文档形态定，旧记录首轮不误存迁移版本）
  if(res.migrated)setTimeout(function(){showToast('已把旧草稿迁移成项目「'+(res.name||'我的编舞')+'」，原草稿已自动备份')},1500);
  if(recovered)setTimeout(function(){showToast('上次好像没正常关闭——已经恢复到最近的编辑')},4500);
}
async function init(){
  await loadActiveProject(); // WP-3：迁移旧草稿 + 打开上次项目（内部自带降级，绝不阻断编辑器）
  var bd=document.createElement("div");bd.id="sbBackdrop";bd.className="sb-backdrop";bd.onclick=closeSidebar;document.body.appendChild(bd);applyCompact();
  // 阶段1（模式分流）：编辑器不再等插件——草稿恢复完直接进网页模式工作区；
  // 插件连接与动作目录改为后台并行加载，游戏没开也能编辑、拖动、网页播放
  if(!store.dancers.length)store.dancers=[makeDancer(0)];
  saveHistory();
  store.appReady=true;
  document.getElementById('loading').classList.add('hidden');
  render();
  probeExport();
  startConnWatch(); // 阶段2：断连时静默轮询，游戏中途启动后自动刷新状态/升级目录
  // 阶段4：上次录制没录完的话提醒一声（会话明细在 localStorage，打开录制窗口能续录）
  try{
    var _rs=JSON.parse(localStorage.getItem('choreo_recSession')||'null');
    if(_rs&&_rs.items&&!_rs.finished&&_rs.items.some(function(it){return it.status==='pending'}))
      showToast('上次录制没录完——点工具栏「⏺ 录制 3D 动作库」可以继续');
  }catch(e){}
  await probeGame(false);
}

// 探测 48795（导出/3D 服务）在线状态：只置标志，不阻断任何功能
function probeExport(){
  // SEC-1：/export/list 是私有读，带配对码（没配对时 403 → 显示未连接，符合实际可用性）。
  // ARCH-2：配对码头归 choreo-api.js 48795 高层 api——非 2xx 走 catch 静默降级，不弹提示
  ChoreoAPI.export.api('/export/list',{method:'GET',timeoutMs:3000})
    .then(function(){store.exportConnected=true})
    .catch(function(){store.exportConnected=false});
}

// 阶段2（离线启动）：游戏没开时用内置目录快照（catalog-snapshot.js）把侧栏立起来。
// 返回 true 表示本次真的填了数据（调用方据此决定要不要提示/重绘）；快照数据套用
// 与线上目录完全相同的归类/过滤/职业表构建逻辑，两边行为一致
// 阶段3：抽出 applyCatalogObject(c)——内置快照和本地资料库缓存的目录共用这套逻辑
function applyCatalogObject(c){
  if(!c||!c.emotes||!c.emotes.length)return false;
  store.emotes=c.emotes.map(function(e){var n=Object.assign({},e);n.category=categorizeEmote(n.name,n.category);return n});
  repairClipNames();
  store.races=c.races||[];
  store.actions=(c.actions||[]).filter(function(a){return a.jobName&&a.jobName.length>0});
  store.classJobs=(c.classJobs||[]).filter(function(j){return j.name&&j.name.length>0});
  store.jobMap={};
  store.classJobs.forEach(function(j){store.jobMap[j.id]={name:j.name,abbr:j.abbreviation,command:'/job "'+j.name+'"',id:j.id,role:j.role}});
  store.catalogFromSnapshot=true;
  return true;
}
function applyCatalogSnapshot(){
  if(store.emotes.length)return false;
  return applyCatalogObject(window.__CHOREO_CATALOG__);
}

// 阶段2（离线启动）：断连时每 15s 静默探测——游戏中途启动后连接状态自动刷新、
// 快照目录自动升级成线上目录；不重载页面、不丢草稿，只在"从断到通"的边沿提示一次
var _connTimer=null;
function startConnWatch(){
  if(_connTimer)return;
  _connTimer=setInterval(async function(){
    if(!store.exportConnected)probeExport();
    // v0.6.7：连着但还没认出新版插件（页面开着时插件热重载升级了）——持续轻探 /capabilities 直到认出
    if(store.gameConnected&&!store.capsOk){probeCaps();return}
    if(store.gameConnected)return;
    var snapLoaded=store.catalogFromSnapshot;
    await probeGame(true,snapLoaded); // 静默探测；目录来自快照时顺带强制升级成线上版
    if(store.gameConnected)showToast(snapLoaded&&snapLoaded===store.catalogFromSnapshot
      ?'游戏已连接'
      :'游戏已连接，动作目录已更新');
  },15000);
}

var _measuredTimer=null;
// v0.6.7 能力握手：新版插件回 {app,version,protocolVersion,pairing,capabilities}；
// 旧插件（≤0.6.6）没有这个端点 → capsOk=false 走兼容模式（写请求不带配对头）。
// 独立成函数：连接监视器也调——页面开着时插件热重载升级（旧→新），capsOk 15s 内自动跟上
async function probeCaps(){
  var was=store.capsOk;
  try{
    var cr=await ChoreoAPI.game.raw('/capabilities',{timeoutMs:3000});
    // FIX-4/AUD-013：capsOk 不再"带 protocolVersion 就认"——必须确认是本插件（app 字段）
    // 且协议版本是数字，才进入新版安全模式（才发配对头）
    if(cr.ok){var cj=await cr.json();
      store.capsOk=!!(cj&&cj.app==='ChoreoHelper'&&typeof cj.protocolVersion==='number');
      store.pluginCaps=cj||null}
    else{store.capsOk=false;store.pluginCaps=null}
  }catch(e){store.capsOk=false;store.pluginCaps=null}
  if(store.capsOk&&!was&&!store.pairToken)
    showToast('检测到新版插件：控制游戏前先配对——游戏里输入 /choreo pair 查码，「⋯ 高级 → 网页配对」粘贴');
  // 插件协议比网页新 → 提示升级网页（网页旧了不认识新协议；反向暂时不存在更高网页协议）
  if(store.capsOk&&store.pluginCaps&&store.pluginCaps.protocolVersion>CHOREO_PROTOCOL)
    showToast('插件版本比网页新——重新打开/刷新网页获取新版，避免功能不匹配');
}
// 探测 48794（游戏插件）并补齐动作目录；失败只置离线状态+提示，不挡编辑器。
// silent=true 时不弹"游戏未连接"提示（调用方自己有更具体的话要说）
// forceCatalog=true 时先清空现有目录再拉线上版（连接监视器用来把快照目录升级成线上目录）
async function probeGame(silent,forceCatalog){
  try{
    var h=await apiFetch('/health');
    if(h.status!=='ok')throw new Error('unhealthy');
    store.gameConnected=true;store.connected=true;
    await probeCaps();
  }catch(err){
    var wasConnected=store.gameConnected;
    store.gameConnected=false;store.connected=false;
    // 阶段2（离线启动）：游戏没开时用内置目录快照兜底，侧栏照样有动作可拖
    var snapOk=applyCatalogSnapshot();
    // 只在状态真正变化时重绘——连接监视器会周期性调到这里，不能反复重建 DOM 打断用户操作
    if(store.appReady&&(wasConnected||snapOk))render();
    if(!silent)showToast(snapOk
      ?'游戏未连接——已按「网页 3D」模式工作，动作目录用内置快照（'+store.emotes.length+' 动作）'
      :'游戏未连接——已按「网页 3D」模式工作，编辑不受影响（点工具栏圆点可重新检测）');
    // 阶段3：内置快照填不上时再查本地资料库缓存的目录（可能比内置快照新）
    if(!snapOk&&window.ChoreoLibrary&&ChoreoLibrary.available()){
      ChoreoLibrary.getCatalog().then(function(cat){
        if(cat&&!store.emotes.length&&applyCatalogObject(cat)&&store.appReady)render();
      }).catch(function(){});
    }
    return;
  }
  // 已连接：同步设置与动作目录（每步独立兜底，单项失败不拖垮别的）
  // 同步引擎偏好到插件（经典/增强）——v0.6.7：新版插件未配对前先跳过（否则每次探测都 403 弹配对提示）
  if(!store.capsOk||store.pairToken){
    try{apiFetch('/settings/engine',{method:'POST',body:JSON.stringify({pinMode:store.engine==='pin'})}).catch(function(){})}catch(e){}
  }
  // 恢复 GPose 模式显示状态（不自动发送命令——用户上次退出时已关）
  try{apiFetch('/gpose/state').then(function(r){if(r.gpose){store.gpose=true;render()}}).catch(function(){})}catch(e){}
  if(forceCatalog){store.emotes=[];store.races=[];store.actions=[];store.classJobs=[]}
  if(!store.emotes.length){
    try{
      var ed=await apiFetch('/actions/emotes');
      store.emotes=(ed.emotes||[]).map(function(e){e.category=categorizeEmote(e.name,e.category);return e});
      repairClipNames(); // 恢复存量 clip 的中文名（旧版英文数据修复）
      var rd=await apiFetch('/actions/races');store.races=rd.races||[];
      var ad=await apiFetch('/actions');
      store.actions=(ad.actions||[]).filter(function(a){return a.jobName&&a.jobName.length>0});
      try{
        var cd=await apiFetch('/classjobs');
        store.classJobs=(cd.classJobs||[]).filter(function(j){return j.name&&j.name.length>0});
      }catch(e){
        store.classJobs=[];
      }
      store.jobMap={};
      store.classJobs.forEach(function(j){store.jobMap[j.id]={name:j.name,abbr:j.abbreviation,command:'/job "'+j.name+'"',id:j.id,role:j.role}});
      store.catalogFromSnapshot=false; // 线上目录到手，快照标记作废
      // 阶段3：线上目录顺手存一份进本地资料库（游戏没开时网页离线也有目录可兜底）
      if(window.ChoreoLibrary&&ChoreoLibrary.available()){
        ChoreoLibrary.putCatalog({
          emotes:store.emotes.map(function(e){return{name:e.name,command:e.command,category:e.category}}),
          races:store.races,actions:store.actions,classJobs:store.classJobs
        }).catch(function(){});
      }
      if(store.appReady){render();showToast('已加载 '+store.emotes.length+' 动作, '+store.actions.length+' 技能, '+store.classJobs.length+' 职业')}
    }catch(err){
      showToast('\u90E8\u5206\u52A8\u4F5C\u6570\u636E\u52A0\u8F7D\u5931\u8D25\uFF08\u53EF\u70B9\u5DE5\u5177\u680F\u5706\u70B9\u91CD\u8FDE\uFF09');
    }
  }
  // 实测动画时长：预览/拖动/播放过的动作会记录真实时长，用于显示与自动校正 clip 时长
  if(!_measuredTimer){
    refreshMeasured();
    _measuredTimer=setInterval(refreshMeasured,5000);
  }
  // 阶段3（自动同步）：连上插件了——发现资料库里缺动作就后台自动补齐，主人不用点任何按钮。
  // 挂在 probeGame 成功处，首次打开/断线重连/点圆点重连三种情况都走这里
  autoSyncLibrary();
  if(store.appReady)render();
}

// 阶段3（自动同步）：网页连上插件后，把插件里已录制、本地资料库还没有的动作自动收进来。
// 全量 264 条约半分钟（后台进行，可正常编辑）；没存上的下次连上自动重试。
// 手动「资料库」窗口导入进行中时让路（_libBusy）；自身防重入（_libAutoBusy）
var _libAutoBusy=false;
function autoSyncLibrary(){
  if(_libAutoBusy||_libBusy)return;
  if(!(window.ChoreoLibrary&&ChoreoLibrary.available()))return;
  _libAutoBusy=true;
  (async function(){
    try{
      // SEC-1：/export/list 私有读带配对码（ARCH-2：码头归 48795 高层 api，非 2xx 抛错走静默 catch）
      var j=await ChoreoAPI.export.api('/export/list');var names=(j&&j.clips)||[];
      var idx=await ChoreoLibrary.clipIndex();
      var have={};idx.forEach(function(c){have[c.name]=true});
      var miss=names.filter(function(n){return !have[n]});
      if(!miss.length)return;   // 库是齐的：什么都不说，安静
      showToast('检测到 '+miss.length+' 个动作还没存进本地，正在后台自动同步…');
      var rep=await ChoreoLibrary.syncFromPlugin({qcFn:recLibQc}); // 阶段4：静止坏数据不进库
      if(rep.imported>0){
        showToast('动作已自动存进本地资料库：新增 '+rep.imported+' 条'
          +(rep.failed.length?('，'+rep.failed.length+' 条没存上（下次连上自动重试）'):''));
        if(window.__p3dLibChanged)__p3dLibChanged();
        _libIdxCache=null;scheduleRealtimeCheck(); // 资料库变了：缺录判定立即重算
      }
    }catch(e){/* 静默：下次连上插件再试 */}
    finally{_libAutoBusy=false}
  })();
}

// 拉取插件实测的动画时长（预览/定格/播放时累积），并自动校正未被手动调过的 clip 时长
function refreshMeasured(){
  apiFetch('/actions/measured-durations').then(function(d){
    if(!d||!d.durations)return;
    var changed=false;
    Object.keys(d.durations).forEach(function(k){
      var v=parseFloat(d.durations[k]);if(!isFinite(v)||v<=0.05)return;
      if(store.measuredDur[k]!==v){store.measuredDur[k]=v;changed=true}
    });
    if(!changed)return;
    // AUD-015：修正循环抽成纯函数（ChoreoEdit.pure.applyMeasuredDurations，node 单测覆盖）；
    // 程序自动修正后立即落盘，不进撤销栈——刚校正完就关页面也不会丢
    var fixed=(window.ChoreoEdit&&ChoreoEdit.pure.applyMeasuredDurations)?ChoreoEdit.pure.applyMeasuredDurations(store.dancers,store.measuredDur):0;
    // WEB-RACE：时长被实测值改掉=时间轴内容变更，revision 必须递增并重推快照（游戏模式下防抖推送）
    if(fixed){bumpTimelineRev();updateTotalDuration();render();persistProject()}
  }).catch(function(){});
}

// solo/mute（WP-3b）：随项目 content.dancers 持久化；生效口径见 ChoreoEdit.pure.isMuted
function makeDancer(idx){return{id:idx,name:'\u821E\u8005'+(idx+1),color:dancerColors[idx%3],switchClips:[],actionClips:[],lyricClips:[],currentJob:'',collapsed:false,laneScale:1,solo:false,mute:false}}

function setDancerCount(n){
  // 六轨八人（TASK-20260901-SIX-TRACK-ROUNDTRIP）：创作上限从 3 放开到 12——与导入校验
  // AUD-002 的 1～12 同一口径；8 人是本包的第一个合奏创作验收门，UI 提供 1～8 快捷按钮
  n=Math.max(1,Math.min(12,n));
  while(store.dancers.length<n)store.dancers.push(makeDancer(store.dancers.length));
  while(store.dancers.length>n)store.dancers.pop();
  store.dancerCount=n;
  if(store.selectedDancer>=n)store.selectedDancer=n-1;
  if(store.gameActor>=n)store.gameActor=n-1; // ACTOR：预览舞者跟着舞者数收拢，读取侧 gameActorIdx 还有兜底
  saveHistory();updateTotalDuration();render()
}

// Get job categories for sidebar
function getJobTabs(){
  var groups={};
  store.actions.forEach(function(a){
    if(a.jobName){
      if(!groups[a.jobName])groups[a.jobName]={count:0,jobId:a.jobId,abbr:a.jobAbbr||'',role:a.jobAbbr||''};
      groups[a.jobName].count++;
    }
  });
  return Object.keys(groups).map(function(name){return{name:name,count:groups[name].count,jobId:groups[name].jobId,abbr:groups[name].abbr}}).filter(function(j){return j.count>=3}).sort(function(a,b){return b.count-a.count});
}

function getFilteredActions(){
  var items=[],q=store.search.toLowerCase();
  if(store.activeTab==='emote-usual')items=store.emotes.filter(function(e){return e.category==='usual'});
  else if(store.activeTab==='emote-special')items=store.emotes.filter(function(e){return e.category==='special'});
  else if(store.activeTab==='emote-expression')items=store.emotes.filter(function(e){return e.category==='expression'});
  else if(store.activeTab==='switch')items=switchItems;
  else if(store.activeTab==='race')items=store.races.filter(function(r){return r.id>0}).map(function(r){return{id:r.id,name:r.masculine||r.feminine,command:'race:'+r.id,category:'绉嶆棌'}});
  else if(store.activeTab==='all')items=store.emotes.concat(store.actions.slice(0,150));
  else if(store.activeTab==='skill-all')items=store.actions.slice(0,400);
  else if(store.activeTab.indexOf('job-')===0){
    var jn=store.activeTab.substring(4);
    items=store.actions.filter(function(a){return a.jobName===jn});
  }
  if(q)items=items.filter(function(i){return(i.name||'').toLowerCase().indexOf(q)>=0||(i.command||'').toLowerCase().indexOf(q)>=0||(i.jobAbbr||'').toLowerCase().indexOf(q)>=0});
  return items.slice(0,300);
}

// Esc：先退宏面板全屏；否则清空多选（WP-3b）
document.addEventListener('keydown',function(e){
  if(e.key!=='Escape')return;
  if(store.macroFullscreen){store.macroFullscreen=false;render();showToast('\u5DF2\u9000\u51FA\u5B8F\u5168\u5C4F');return}
  if(window.ChoreoEdit&&edHasSel()){clearClipSelection();render()}
});

// Delete/Backspace 删除选中的 clip（输入框中不生效）；多选时整批删（WP-3b）
document.addEventListener('keydown',function(e){
  if(e.key!=='Delete'&&e.key!=='Backspace')return;
  var t=e.target;
  if(t&&(t.tagName==='INPUT'||t.tagName==='TEXTAREA'||t.isContentEditable))return;
  if(!store.selectedClip&&!edHasSel())return;
  var n=edSel().length;
  deleteSelectedClips();
  if(n>1)showToast('已删除 '+n+' 条');
  e.preventDefault();
});

// Conflict check：返回造成冲突的另一轨 clip 的最晚结束时刻（无冲突返回 0）
function conflictEnd(di,tt,ns,nd,ex){
  var d=store.dancers[di];if(!d)return 0;
  if(tt!=='switch'&&tt!=='action')return 0;
  var ot=tt==='switch'?'actionClips':'switchClips';
  var other=d[ot];var ne=ns+nd;var ret=0;
  for(var i=0;i<other.length;i++){
    var c=other[i];if(c.id===ex)continue;
    var cE=c.start+c.duration;
    if(ns<cE-0.01&&ne>c.start+0.01&&cE>ret)ret=cE;
  }
  return ret;
}
function hasConflict(di,tt,ns,nd,ex){return conflictEnd(di,tt,ns,nd,ex)>0}

// 自动补齐规则（2026-08-28 主人拍板改）：手动编辑（拖动/缩短/删除/改时长）不再自动回填——
// 空隙是用户的显式意图，界面如实显示。只剩两种场景自动补：
//   ① 新增动作插入中间：只延长"新插入的这条"接住下一个（addClip 传 onlyClip）
//   ② 导入工程 / 解析宏：整轨全量补齐（"生成连续时间轴"的语义没变）
// 想补齐留出的空隙：动作条右键菜单「补齐空隙」
function autoFillGaps(di,onlyClip){
  var d=store.dancers[di];if(!d)return;
  var arr=d.actionClips.slice().sort(function(a,b){return a.start-b.start});
  if(onlyClip){ // 只补指定 clip 到下一个之间的缝（新增插入场景，不动其他 clip）
    var i=arr.indexOf(onlyClip);if(i<0||i>=arr.length-1)return;
    var a=arr[i],b=arr[i+1];
    if(b.start-(a.start+a.duration)>0.05){
      a.duration=Math.round((b.start-a.start)*10)/10;
      if(a.autoDur)a.autoDur=false;
    }
    return;
  }
  for(var j=0;j<arr.length-1;j++){
    var a2=arr[j],b2=arr[j+1];
    if(b2.start-(a2.start+a2.duration)>0.05){
      a2.duration=Math.round((b2.start-a2.start)*10)/10;
      if(a2.autoDur)a2.autoDur=false; // 补齐是显式时长，不再被实测时长自动校正顶掉
    }
  }
}

// Add clip with auto job switch
// noSave：批量插入（添加到全部舞者）时静默——落位/建条照旧，历史/落盘/重绘由调用方一次性收尾
function addClip(di,tt,data,st,noSave){
  var d=store.dancers[di];if(!d)return false;
  if(st===undefined){var d0=store.dancers[di];var arr0=d0[tt+'Clips'];var lastEnd0=0;arr0.forEach(function(c){var e0=c.start+c.duration;if(e0>lastEnd0)lastEnd0=e0});st=lastEnd0}
  var dur=data.duration||(data.isLoop?3:(store.measuredDur[data.command]||3));
  var autoDur=!data.duration&&!data.isLoop; // 非循环动作：时长来自默认/实测值，拿到实测后自动校正
  // 落位（AUD-010）：动作条走纯函数 planActionPlacement（node 单测覆盖）——
  //   动作窗口与切职业轨冲突 → +0.05 顺延（原口径）；需要自动切职业时，切职业占 0.5s、
  //   恰好在动作开始时结束（与宏 <wait.0.5> 一致），其窗口被占 → 动作连同切职业整体 +0.5 顺延。
  //   切职业轨直接拖放保留原语义（conflictEnd 看动作轨）。
  var plan={st:st,swStart:0,swDur:0},needSwitch=false;
  if(tt==='action'){
    needSwitch=!!(data.jobName&&data.jobName!==d.currentJob&&store.jobMap&&store.jobMap[data.jobId]);
    plan=ChoreoEdit.pure.planActionPlacement(d.switchClips,d.actionClips,st,dur,needSwitch);
    if(plan.st!==st)showToast('已自动顺延到 '+plan.st.toFixed(1)+'s（切换和动作轨不能重叠）');
    st=plan.st;
  }else if(tt!=='lyric'){
    var guard=0,ce;
    while((ce=conflictEnd(di,tt,st,dur))>0&&guard++<50){st=ce+0.05}
    if(guard>0)showToast('已自动顺延到 '+st.toFixed(1)+'s（切换和动作轨不能重叠）');
  }
  // Auto job switch（0.5 秒、结束于动作开始；同职业连续动作由 needSwitch 条件天然去重）
  if(needSwitch){
    var ji=store.jobMap&&store.jobMap[data.jobId];
    d.switchClips.push({id:store.nextClipId++,start:plan.swStart,duration:plan.swDur,data:{name:'\u5207\u6362: '+data.jobName,command:ji.command,category:'\u5207\u6362',isJobSwitch:true,jobName:data.jobName,jobId:data.jobId}});
    d.currentJob=data.jobName;
  }
  var nc={id:store.nextClipId++,start:Math.max(0,st),duration:dur,autoDur:autoDur,data:{id:data.id,name:data.name,command:data.command,category:data.category,jobName:data.jobName,jobId:data.jobId,jobAbbr:data.jobAbbr}};
  d[tt+'Clips'].push(nc);
  if(tt==='action')autoFillGaps(di,nc); // 拖放插入中间时只把"新插入的这条"延长接住下一个，不动其他动作
  if(!noSave){saveHistory();updateTotalDuration();render()}
  return true;
}

// MULTI-DANCER（TASK-20260831-MULTI-DANCER-EDIT）：把一条动作在同一时刻插给每位在场舞者（齐奏）。
// 落位规划走纯函数 planMultiActionPlacement（node 单测覆盖）：每位按既有 per-dancer 规则
// （planActionPlacement：切职业 0.5s、冲突顺延）各算各的，某舞者自己轨道冲突时只有那一位被
// 顺延，其余保持请求起点，既有条永不移动。建条字段与 addClip 逐字段同口径（含自动切职业与
// autoFill），保证编译/播放与手摆条完全一致。单人（或开关关）原样走 addClip，行为零变化。
function addClipToAllDancers(item,st){
  if(store.dancers.length<=1){addClip(store.selectedDancer,'action',item,st);return}
  var dur=item.duration||(item.isLoop?3:(store.measuredDur[item.command]||3));
  var autoDur=!item.duration&&!item.isLoop; // 与 addClip 同口径：非循环动作拿实测后自动校正
  var plan=ChoreoEdit.pure.planMultiActionPlacement(store.dancers,st,dur,item,store.jobMap);
  var deferred=[];
  plan.forEach(function(p){
    if(!p)return;
    var d=store.dancers[p.di];
    if(p.needSwitch){ // 自动切职业：切职业条字段与 addClip 逐字一致
      var ji=store.jobMap[item.jobId];
      d.switchClips.push({id:store.nextClipId++,start:p.swStart,duration:p.swDur,data:{name:'\u5207\u6362: '+item.jobName,command:ji.command,category:'\u5207\u6362',isJobSwitch:true,jobName:item.jobName,jobId:item.jobId}});
      d.currentJob=item.jobName;
    }
    var nc={id:store.nextClipId++,start:Math.max(0,p.st),duration:dur,autoDur:autoDur,data:{id:item.id,name:item.name,command:item.command,category:item.category,jobName:item.jobName,jobId:item.jobId,jobAbbr:item.jobAbbr}};
    d.actionClips.push(nc);
    autoFillGaps(p.di,nc);
    if(p.deferred)deferred.push(d.name);
  });
  if(deferred.length)showToast(deferred.join('\u3001')+' \u5DF2\u987A\u5EF6\uFF08\u5207\u6362\u548C\u52A8\u4F5C\u8F68\u4E0D\u80FD\u91CD\u53E0\uFF09\uFF0C\u5176\u4F59\u821E\u8005\u4FDD\u6301 '+st.toFixed(1)+'s');
  saveHistory();updateTotalDuration();render(); // 整次多舞者插入只进一步撤销
}

// MULTI-DANCER：把 srcIdx 舞者的三条轨一次性复制给 dstIdx 舞者。
// 空源 toast 不动；非空目标 confirm（取消=零改动）；纯函数 copyDancerTracks 深拷贝+发新 id；
// 一次 saveHistory=一步撤销整次复制
function copyDancerTracksFrom(dstIdx,srcIdx){
  var src=store.dancers[srcIdx],dst=store.dancers[dstIdx];
  if(!src||!dst||srcIdx===dstIdx)return;
  var tracks=['switch','action','lyric'];
  var srcEmpty=!tracks.some(function(t){return (src[t+'Clips']||[]).length});
  if(srcEmpty){showToast(src.name+' \u7684\u8F68\u9053\u662F\u7A7A\u7684\uFF0C\u6CA1\u6709\u53EF\u590D\u5236\u7684\u5185\u5BB9');return}
  var dstHas=tracks.some(function(t){return (dst[t+'Clips']||[]).length});
  if(dstHas&&!confirm('\u628A '+src.name+' \u7684\u5168\u90E8\u8F68\u9053\u590D\u5236\u5230 '+dst.name+'\uFF1F'+dst.name+' \u73B0\u6709\u7684\u8F68\u9053\u5185\u5BB9\u4F1A\u88AB\u66FF\u6362'))return;
  ChoreoEdit.pure.copyDancerTracks(store.dancers,srcIdx,dstIdx,function(){return store.nextClipId++});
  saveHistory();updateTotalDuration();render();
  showToast('\u5DF2\u628A '+src.name+' \u7684\u4E09\u6761\u8F68\u9053\u590D\u5236\u7ED9 '+dst.name+'\uFF08\u4E00\u6B21\u64A4\u9500\u53EF\u6574\u6B65\u8FD8\u539F\uFF09');
}
function showCopyTracksMenu(x,y,dstIdx){ // 舞者行头「⧉」菜单：列其他舞者作为复制源（复用 #ctxMenu 容器）
  var m=document.getElementById('ctxMenu');m.innerHTML='';
  var offered=0;
  store.dancers.forEach(function(d,si){
    if(si===dstIdx)return; // 源=目标不提供
    offered++;
    var mi=el('div','ctx-it','\u21C9 \u4ECE'+d.name+'\u590D\u5236\u5168\u90E8\u8F68\u9053');
    mi.onclick=function(){m.classList.remove('show');copyDancerTracksFrom(dstIdx,si)};
    m.appendChild(mi);
  });
  if(!offered)return;
  m.style.left=x+'px';m.style.top=y+'px';m.classList.add('show');
}
function addClipToTrack(di,tt,data,st){
  var d=store.dancers[di];if(!d)return;
  if(st===undefined){var arr=d[tt+'Clips'];var lastEnd=0;arr.forEach(function(c){var e=c.start+c.duration;if(e>lastEnd)lastEnd=e;st=Math.round(st*2)/2});st=lastEnd}
  d[tt+'Clips'].push({id:store.nextClipId++,start:st,duration:data.duration||3,data:data});
  saveHistory();updateTotalDuration();render();
}

function deleteClip(id){
  store.dancers.forEach(function(d){d.switchClips=d.switchClips.filter(function(c){return c.id!==id});d.actionClips=d.actionClips.filter(function(c){return c.id!==id});d.lyricClips=d.lyricClips.filter(function(c){return c.id!==id})});
  store.globalLyrics=store.globalLyrics.filter(function(c){return c.id!==id});
  if(store.selectedClip&&store.selectedClip.id===id)store.selectedClip=null;
  // 删除后不再自动回填：空隙是用户的显式意图，想补齐用右键「补齐空隙」
  saveHistory();updateTotalDuration();render();
}

function duplicateClip(clip){
  // Search in dancers
  for(var di=0;di<store.dancers.length;di++){
    var d=store.dancers[di];
    for(var tt of['switch','action','lyric']){
      var arr=d[tt+'Clips'];
      var idx=arr.indexOf(clip);
      if(idx>=0){
        var ns=clip.start+clip.duration; // 紧贴被复制条末端生成（2026-08-29 主人反馈，不留缝）
        var nc=JSON.parse(JSON.stringify(clip));nc.id=store.nextClipId++;nc.start=ns;
        // 腾位再落副本：本轨被副本压到的条目整体右移，复制完时间轴零重叠
        ChoreoEdit.pure.makeRoom(arr,ns,clip.duration);
        arr.push(nc);
        saveHistory();updateTotalDuration();render();return;
      }
    }
  }
  // Search in global lyrics
  var gi=store.globalLyrics.indexOf(clip);
  if(gi>=0){
    var ns2=clip.start+clip.duration; // 紧贴被复制条末端生成
    var nc2=JSON.parse(JSON.stringify(clip));nc2.id=store.nextClipId++;nc2.start=ns2;
    ChoreoEdit.pure.makeRoom(store.globalLyrics,ns2,clip.duration);
    store.globalLyrics.push(nc2);
    saveHistory();updateTotalDuration();render();
  }
}

function updateTotalDuration(){
  // 固定轨道长度制（基础 5 分钟）：拖动被钳制在轨道末端，超出需点"+1分钟"手动加长；
  // 导入/粘贴等内容超出时仍自动生长（否则歌词会落在轨道外不可见）。只增不减，保留手动加长。
  var max=300;
  store.dancers.forEach(function(d){['switchClips','actionClips','lyricClips'].forEach(function(k){d[k].forEach(function(c){var e=c.start+c.duration;if(e>max)max=e})})});
  store.globalLyrics.forEach(function(c){var e=c.start+c.duration;if(e>max)max=e});
  var need=Math.ceil(max);
  if(need>store.totalDuration)store.totalDuration=need;
}

// Import lyrics to global track
function importLyrics(lrc){
  var ly=parseLRC(lrc);
  if(!ly.length){showToast('未找到有效歌词');return}
  store.globalLyrics=[];
  for(var i=0;i<ly.length;i++){
    var st=ly[i].time,end=i+1<ly.length?ly[i+1].time:st+5;
    store.globalLyrics.push({id:store.nextClipId++,start:st,duration:Math.max(0.5,end-st),data:{name:ly[i].text,command:'',category:'lyric',isLyric:true}});
  }
  saveHistory();updateTotalDuration();render();
  showToast('已导入 '+ly.length+' 行歌词到全局歌词轨');
}

// Macro generation
function generateMacro(di){
  var d=store.dancers[di];if(!d)return[];
  // 事件组装走 ChoreoEdit.pure.macroEvents（FIX-4/AUD-013：与体检宏检查共用同一份口径，
  // 含开歌词宏时的全局歌词和同刻去重规则；顺序 switch→action→歌词 与原实现逐字一致）
  var all=ChoreoEdit.pure.macroEvents(d,store.globalLyrics,store.showLyricMacro);
  all.sort(function(a,b){return a.clip.start-b.clip.start});
  function fmtWait(d){d=Math.round(d*2)/2;var s=d.toFixed(1);if(s.indexOf('.0')===s.length-2)s=s.substring(0,s.length-2);return '<wait.'+s+'>'}
  // Group clips by same start time (within 0.1s)
  var groups=[];
  all.forEach(function(item){
    if(groups.length===0||item.clip.start-groups[groups.length-1].start>0.1){
      groups.push({start:item.clip.start,items:[item]})
    }else{groups[groups.length-1].items.push(item)}
  });
  var macroLines=[];
  var currentJob='';
  groups.forEach(function(g,gi){
    // Calculate wait for this group = time until next group starts
    // If this is the last group, wait = max clip duration in group
    var nextStart=gi<groups.length-1?groups[gi+1].start:null;
    g.items.forEach(function(item,ii){
      var c=item.clip;
      var cmd=c.data.command||'';
      var isLastInGroup=ii===g.items.length-1;
      var waitStr='';
      if(isLastInGroup){
        if(nextStart!==null){
          // Wait = gap to next group
          var wait=nextStart-g.start;
          if(wait>=0.5)waitStr=' '+fmtWait(wait);
        }else{
          // Last group: use own duration as wait
          if(c.duration>=0.5)waitStr=' '+fmtWait(c.duration);
        }
      }
      if(item.type==='switch'){
        if(c.data.jobName)currentJob=c.data.jobName;
        macroLines.push(cmd+waitStr);
      }else if(item.type==='lyric'){
        // 文字宏：歌词/文字 clip 无命令时输出 "/say 文字"（此前输出空行 = 文字宏整个丢失）
        if(!cmd&&c.data.name)cmd='/say '+c.data.name;
        if(cmd)macroLines.push(cmd+waitStr);
      }else{
        if(c.data.jobName&&c.data.jobName!==currentJob){
          var ji=store.jobMap&&store.jobMap[c.data.jobId];
          if(ji){macroLines.push(ji.command+' <wait.0.5>');currentJob=c.data.jobName}
        }
        var noWaitCmds=['\u623F\u5C4B','house','\u4F0F\u5C4B'];
        var needsWait=true;
        noWaitCmds.forEach(function(nc){if(cmd.indexOf(nc)>=0)needsWait=false});
        macroLines.push(cmd+(needsWait?waitStr:''));
      }
    });
  });
  var resultLines=['/echo \u7F16\u821E: '+d.name];
  var maxLines=14; // 游戏单宏槽 15 行：每 14 行动作分页 + /nextmacro 连续执行，留 1 行余量
  for(var i=0;i<macroLines.length;i++){
    resultLines.push(macroLines[i]);
    if((i+1)%maxLines===0&&i<macroLines.length-1){resultLines.push('/nextmacro')}
  }
  return resultLines;
}

// Parse macro back
function parseMacroToClips(text,di){
  var d=store.dancers[di];if(!d)return;
  var rawLines=text.split('\n');
  var sw=[],ac=[],ly=[];
  var t=0;
  rawLines.forEach(function(line){
    line=line.trim();
    if(!line)return;
    if(line[0]!=='/'&&line[0]!=='<')return;
    if(line.indexOf('/echo')===0&&(line.indexOf('\u7F16\u821E')>=0||line.indexOf('========')>=0))return;
    if(line.indexOf('/nextmacro')===0)return;
    // Extract <wait.X> from end of line
    var waitMatch=line.match(/<wait\.(\d+(?:\.\d+)?)>\s*$/i);
    var dur=0.5;
    if(waitMatch){dur=parseFloat(waitMatch[1]);line=line.replace(/<wait\.[^>]+>\s*$/i,'').trim()}
    // Handle /wait X as separate line (legacy)
    if(line.match(/^\/wait\s+/i)){var w=parseFloat(line.replace(/^\/wait\s+/i,'').trim());if(w)t+=w;return}
    var sp=line.indexOf(' ');
    var cmd=sp>0?line.substring(0,sp).toLowerCase():line.toLowerCase();
    var args=sp>0?line.substring(sp+1).trim():'';
    // /y or /sh or /say -> lyric
    if(cmd==='/y'||cmd==='/sh'||cmd==='/say'){
      ly.push({id:store.nextClipId++,start:t,duration:Math.max(0.5,dur),data:{name:args,command:line,category:'lyric',isLyric:true}});
      t+=dur;return
    }
    // /echo -> lyric
    if(cmd==='/echo'){
      if(args.indexOf('\u7F16\u821E')>=0||args==='========')return;
      ly.push({id:store.nextClipId++,start:t,duration:Math.max(0.5,dur),data:{name:args,command:line,category:'lyric',isLyric:true}});
      t+=dur;return
    }
    // /p or /e -> lyric (party/echo text)
    if(cmd==='/p'||cmd==='/e'){
      ly.push({id:store.nextClipId++,start:t,duration:Math.max(0.5,dur),data:{name:args,command:line,category:'lyric',isLyric:true}});
      t+=dur;return
    }
    // /gs change N -> switch
    if(cmd==='/gs'||cmd==='/gearset'){
      sw.push({id:store.nextClipId++,start:t,duration:Math.max(0.5,dur),data:{name:line,command:line,category:'switch',isJobSwitch:true,jobName:args}});
      t+=dur;return
    }
    // /job -> switch
    if(cmd==='/job'){
      var jn=args.replace(/["\u201c\u201d]/g,'');
      sw.push({id:store.nextClipId++,start:t,duration:Math.max(0.5,dur),data:{name:jn,command:line,category:'switch',isJobSwitch:true,jobName:jn}});
      t+=dur;return
    }
    // /ac or /action -> action
    if(cmd==='/ac'||cmd==='/action'){
      ac.push({id:store.nextClipId++,start:t,duration:Math.max(0.5,dur),data:{name:args,command:line,category:'skill'}});
      t+=dur;return
    }
    // /倒计时 -> special countdown
    if(line.indexOf('/\u5012\u8BA1\u65F6')===0){
      ac.push({id:store.nextClipId++,start:t,duration:Math.max(dur,parseFloat(args)||5),data:{name:line,command:line,category:'expression'}});
      t+=dur;return
    }
    // Everything else: emote or system command
    // 名字优先从表情表回查中文（/bow->行礼）；此前直接取命令去斜杠 = 编辑回填后全变英文。
    // "motion/loop/special" 是变体后缀不是名字（/bow motion 的名字是"行礼"而非"motion"）
    var name=args||'';
    if(name==='motion'||name==='loop'||name==='special')name='';
    var cat='expression';
    if(!name&&store.emotes){
      for(var ei=0;ei<store.emotes.length;ei++){
        if((store.emotes[ei].command||'').toLowerCase()===cmd){
          name=store.emotes[ei].name;cat=store.emotes[ei].category||'expression';break;
        }
      }
    }
    if(!name)name=line.replace(/^\//,'').trim()||line;
    ac.push({id:store.nextClipId++,start:t,duration:Math.max(0.5,dur),data:{name:name,command:line,category:cat}});
    t+=dur;
  });
  d.switchClips=sw;d.actionClips=ac;d.lyricClips=ly;
  d.currentJob=sw.length>0?(sw[sw.length-1].data.jobName||null):null;
  autoFillGaps(di); // 宏解析后动作间空隙补齐
  saveHistory();updateTotalDuration();render();
}

// 宏编辑光标恢复:render() 全量重建 textarea 时会吞光标,重绘后若文本一致则恢复
var macroCaretRestore=null;

// Playback
var playRAF=null,playStart=0,playOffset=0;
// 后台标签页 RAF 被节流:切到游戏窗口时播放头停走,回来跳变 -> 用 visibilitychange 补偿
var playLastVisTime=0;
document.addEventListener('visibilitychange',function(){
  if(document.hidden){
    playLastVisTime=performance.now();
  }else if(store.isPlaying&&playLastVisTime){
    var gap=(performance.now()-playLastVisTime)/1000*store.speed;
    playOffset+=gap; // 补偿后台流逝的时间,播放头与插件时间轴对齐
    playStart=performance.now();
    updatePlayhead();updateTimeDisplay();updatePlayOverlay();
  }
});
// 阶段1（模式分流）：播放拆成本地控制 + 游戏请求包装两条路——
// web 模式纯本地立即起播（不等插件、游戏关着也能播）；game 模式完整保留 v0.6.6 语义
// （先发插件 start 成功才进入播放态；stop/解冻照旧）
function togglePlay(){
  if(store.isPlaying)pausePlay();
  else startPlay();
}
// 暂停：只停本地播放头；游戏模式额外通知插件停，web 模式不发任何请求
function pausePlay(){
  playToken++;
  store.isPlaying=false;if(playRAF)cancelAnimationFrame(playRAF);
  stopFollow(); // GAMECLOCK：暂停即停轮询，本地钟完全接管
  if(store.previewTarget==='game')apiFetch('/playback/stop',{method:'POST'}).catch(function(){});
  var ov=document.getElementById('playOverlay');if(ov)ov.style.display='none';
  render();
}
function startPlay(){
  if(store.previewTarget==='game'){gameStartPlay();return}
  // WP-3b：A-B 循环——播放头在区间外时先拉回 A 再起播
  if(edHasLoop()&&(store.currentTime<store.loopA||store.currentTime>=store.loopB))store.currentTime=store.loopA;
  var tk=++playToken;
  store.isPlaying=true;playStart=performance.now();playOffset=store.currentTime;
  var ov=document.getElementById('playOverlay');if(ov)ov.style.display='block';
  updatePlayOverlay();
  render();
  playLoop(tk);
}
// 游戏模式播放：只发「游戏预览舞者」一人的时间轴（+全局歌词）给 48794，成功后网页播放头
// 才进入播放态（防 start 失败但 UI 显示播放中）
function gameStartPlay(){
  var pdi=gameActorIdx();
  if(pdi<0){showToast('没有舞者可预览：先添加舞者再播放');return}
  var go=function(){
    // 播放前先解冻:退出定格预览,避免定格残留影响播放
    apiFetch('/playback/freeze',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({command:''})}).catch(function(){});
    // ACTOR（2026-08-31）：payload 只装预览舞者（组装逻辑抽在 choreo-edit.js 纯函数里，
    // test-edit.js 覆盖）；插件侧也拒绝混演员包，双保险
    var allClips=buildGamePayloadClips();
    if(!allClips.length){showToast('游戏没动：预览舞者「'+store.dancers[pdi].name+'」名下没有可播放的条目。先给他排动作，或点其他舞者行头的「🎮 预览」换人');return}
    // Send to plugin and start playback (await result before UI state: 防止 start 失败但 UI 显示播放中)
    // HYGIENE(AC-4)：不再向控制台倾倒整包 clips/原始响应/逐条明细——排障走结构化 toasts 与连接状态
    apiFetch('/playback/start',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({clips:allClips,revision:store._tlRevision,fromTime:store.currentTime,speed:store.speed})
    }).then(function(d){
      // v0.7.1：插件业务失败旧版会包在 HTTP 200 里返回 {error:...}——必须看响应体，
      // 不能 fetch 一成功就当播放成功（曾出现游戏没动、网页却显示播放中的假象）
      if(!d||d.error||d.status!=='playing'){
        var why=(d&&d.message)||'插件返回异常，未开始播放';
        showToast('游戏没动：'+why);
        return;
      }
      var tk=++playToken;
      store.isPlaying=true;playStart=performance.now();playOffset=store.currentTime;
      var ov=document.getElementById('playOverlay');if(ov)ov.style.display='block';
      if(store.isPlaying)updatePlayOverlay();
      render();
      startFollow(); // GAMECLOCK：起播即跟随插件钟（能力位不满足时是空操作）
      playLoop(tk);
    }).catch(function(e){
      console.error('Playback start error:',e);
      var m=(e&&e.message)||'';
      if(m.indexOf('403')>=0){ // 配对没过不是连接问题：连接状态别动（曾误标断连圆点变红），给准确指路
        showToast('游戏没动：配对码不对或没带上。游戏里输入 /choreo pair 查看配对码，到「⋯ 高级 → 网页配对」重新粘贴（输入法用英文半角）');
        return;
      }
      if(e&&e.status){ // v0.7.1：插件明确拒绝（400/409/503…）——连接没问题，给插件给的中文原因
        showToast('游戏没动：'+(e.detail||'插件拒绝了这次播放（'+e.status+'）'));
        return;
      }
      store.gameConnected=false;store.connected=false;
      render();
      showToast('\u6E38\u620F\u64AD\u653E\u5931\u8D25\uFF1A\u63D2\u4EF6\u672A\u8FDE\u63A5\u6216\u542F\u52A8\u5F02\u5E38\uFF08\u53EF\u5207\u56DE\u300C\u7F51\u9875 3D\u300D\u6A21\u5F0F\u7EE7\u7EED\u5DE5\u4F5C\uFF09');
    });
  };
  // 未连接时先探一次（快速失败，别对着空气等 4 秒超时）
  if(store.gameConnected){go();return}
  probeGame(true).then(function(){
    if(store.gameConnected)go();
    else showToast('\u6E38\u620F\u672A\u8FDE\u63A5\uFF1A\u65E0\u6CD5\u5728\u6E38\u620F\u5185\u64AD\u653E\u3002\u542F\u52A8\u6E38\u620F\u540E\u70B9\u5DE5\u5177\u680F\u5706\u70B9\u91CD\u8FDE\uFF0C\u6216\u5207\u56DE\u300C\u7F51\u9875 3D\u300D\u6A21\u5F0F');
  });
}
function playLoop(tk){
  if(!store.isPlaying||tk!==playToken)return; // 过期调用直接退出(防 stop/start 乱序)
  var e=(performance.now()-playStart)/1000*store.speed;
  store.currentTime=playOffset+e;
  // GAMECLOCK：跟随态（game 模式+statusV2+已有基准样本）用插件钟外推覆盖本地推进；
  // 没有基准/轮询失败时上面的本地推进原样生效——行为与旧版完全一致
  if(_followState&&_followState.base&&window.ChoreoEdit){
    var pt=ChoreoEdit.pure.followProject(_followState.base,performance.now()/1000);
    if(pt!==null&&isFinite(pt)&&pt>=0){_followState.display=pt;store.currentTime=pt}
  }
  // WP-3b：A-B 循环（仅网页播放）——到 B 回卷 A，动作经引擎插值连续过渡；不设循环走原终止逻辑
  if(edHasLoop()){
    if(store.currentTime>=store.loopB){
      store.currentTime=store.loopA;playOffset=store.loopA;playStart=performance.now();
    }
  }else if(store.currentTime>=store.totalDuration){
    store.currentTime=store.totalDuration;store.isPlaying=false;render();
    stopFollow(); // GAMECLOCK：播完停轮询
    if(store.previewTarget==='game')apiFetch('/playback/stop',{method:'POST'}).catch(function(){});
    var ov=document.getElementById('playOverlay');if(ov)ov.style.display='none';return;
  }
  updatePlayhead();updateTimeDisplay();
  updatePlayOverlay();
  playRAF=requestAnimationFrame(function(){playLoop(tk)});
}
var playToken=0; // 播放令牌:防止 stop/start 乱序,只接受最新一次操作

// ---------- GAMECLOCK：游戏模式时钟跟随（TASK-20260831） ----------
// 仅当 game 模式 + 插件 /capabilities 带 statusV2 能力位时轮询 /playback/status（约 5Hz），
// 把播放头对齐插件权威时钟；轮询失败/插件暂停一律静默退回本地钟（播放不停、不报错）。
// 非目标（AUD2-002 结论保持）：不建逐骨实时姿态流——预览对齐只有时钟跟随这一条通道。
// web 预览模式从不出现在 followCapable() 里，零新请求（旧插件/网页行为字节级不变）。
var _followState=null,_followTimer=null;
function followCapable(){
  return store.previewTarget==='game'&&store.capsOk
    &&!!(window.ChoreoEdit&&ChoreoEdit.pure.hasCap&&ChoreoEdit.pure.hasCap(store.pluginCaps,'statusV2'));
}
function stopFollow(){
  if(_followTimer){clearInterval(_followTimer);_followTimer=null}
  _followState=null;
}
function startFollow(){
  stopFollow();
  if(!followCapable())return; // 旧插件（无 statusV2）或网页模式：今天的本地钟行为，一字节不改
  _followTimer=setInterval(function(){
    if(!store.isPlaying||store.previewTarget!=='game'){return}
    apiFetch('/playback/status').then(function(j){
      if(!store.isPlaying)return; // 轮询回来时已停/已暂停：样本作废
      if(!j||typeof j!=='object'||j.error)return;
      var prev=(_followState&&_followState.stamp!=null)?{stamp:_followState.stamp,display:_followState.display}:null;
      // 本地刚收到载荷：龄记 0，后续流逝由 followProject 用本地钟外推（stampMs 只用于乱序判别）
      var r=ChoreoEdit.pure.followAccept(prev,{time:j.time,stampMs:j.stampMs,stampAgeMs:0,speed:j.speed,playing:j.playing});
      if(r.accepted){
        r.base.recvSec=performance.now()/1000;
        _followState={stamp:r.stamp,base:r.base,display:(_followState&&_followState.display)||store.currentTime};
        if(r.resync){store.currentTime=r.base.time;_followState.display=r.base.time} // 漂移超阈值：硬切对齐
      }else if(r.local){
        // 插件播完/暂停（预览舞者时间轴通常比整个项目短）：交还本地钟，播放继续到项目末尾
        _followState=null;
      }
      // accepted:false（旧样本/坏载荷）→ 保持现状，下个轮询周期再试
    }).catch(function(){/* 网络失败：静默退本地钟，恢复后自动跟上（AC-3）*/});
  },200);
}
// 停止：播放头归零（v0.5 语义不变）；web 模式只清网页状态，不发插件请求
function stopPlay(){playToken++;store.isPlaying=false;if(playRAF)cancelAnimationFrame(playRAF);stopFollow();store.currentTime=0;if(store.previewTarget==='game')apiFetch('/playback/stop',{method:'POST'}).catch(function(){});var ov=document.getElementById('playOverlay');if(ov)ov.style.display='none';render()}
// HYGIENE(AC-2)：播放期间每 tick 都会调 updatePlayOverlay，但活动条目集合大多不变——
// 内容没变就不写 DOM（稳态播放期 MutationObserver 看不到 childList 变动；集合变化时整串重写，
// 展示内容与逐帧重写的旧实现完全一致）。缓存挂在节点上（ov._poHtml，同 toast 的 t._t 约定）：
// render() 会重建 #playOverlay 节点，重建后的新节点没有缓存，首 tick 即写回，不会错漏显示。
function updatePlayOverlay(){
  var ov=document.getElementById('playOverlay');if(!ov)return;
  var t=store.currentTime;
  var items=[];
  store.dancers.forEach(function(d,di){
    d.actionClips.forEach(function(c){if(t>=c.start&&t<c.start+c.duration)items.push({dancer:d.name,di:di,type:'action',clip:c})});
    d.lyricClips.forEach(function(c){if(t>=c.start&&t<c.start+c.duration)items.push({dancer:d.name,di:di,type:'lyric',clip:c})});
    d.switchClips.forEach(function(c){if(t>=c.start&&t<c.start+c.duration)items.push({dancer:d.name,di:di,type:'switch',clip:c})});
  });
  store.globalLyrics.forEach(function(c){if(t>=c.start&&t<c.start+c.duration)items.push({dancer:'\u5168\u5C40',di:-1,type:'lyric',clip:c})});
  var html='';
  if(items.length===0){
    html='<div class=\"po-empty\">\u6682\u65E0\u52A8\u4F5C</div>';
  }else{
    items.forEach(function(it){
      var cls=it.type==='action'?'po-action':it.type==='lyric'?'po-lyric':'po-switch';
      var icon=it.type==='action'?'\u{1F3B6}':it.type==='lyric'?'\u{1F4AC}':'\u{1F504}';
      var nm=it.clip.data.name||'';nm=nm.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      var dn=String(it.dancer).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      html+='<div class=\"po-item '+cls+'\"><span class=\"po-dancer\">'+dn+'</span><span class=\"po-icon\">'+icon+'</span><span class=\"po-name\">'+nm+'</span></div>';
    });
  }
  if(ov._poHtml!==html){ov.innerHTML=html;ov._poHtml=html}
}
function updatePlayhead(){var p=document.getElementById('playhead');if(p){p.style.left=(LABEL_W+store.currentTime*store.pps)+'px';p.style.display='block'}var bp=document.getElementById('bottomPlayhead');if(bp)bp.style.left=(LABEL_W+store.currentTime*store.pps)+'px'}

// 阶段1（模式分流）：模式切换。web→game 先探连接（失败只提示，不拦截编辑）；
// game→web 明确 stop+解冻游戏，不能留半冻结角色。两种模式共用同一份时间轴和播放头
function switchPreviewTarget(){
  var to=store.previewTarget==='web'?'game':'web';
  store.previewTarget=to;
  try{localStorage.setItem('choreo_previewTarget',to)}catch(e){}
  stopFollow(); // GAMECLOCK：切模式清跟随（game→web 不留轮询；web→game 由下次起播重建）
  render();
  if(to==='game'){
    probeGame(true).then(function(){
      render();
      if(!store.gameConnected)showToast('\u6E38\u620F\u672A\u8FDE\u63A5\uFF1A\u7F16\u8F91\u4E0D\u53D7\u5F71\u54CD\uFF0C\u6E38\u620F\u5185\u62D6\u52A8/\u64AD\u653E\u6682\u4E0D\u53EF\u7528\uFF08\u542F\u52A8\u6E38\u620F\u540E\u70B9\u5DE5\u5177\u680F\u5706\u70B9\u91CD\u8FDE\uFF09');
      else{
        pushGameTimeline(true); // FIX-B：进游戏模式先把当前时间轴快照推给插件（未按播放就能拖动定格）
        var pdi=gameActorIdx(),pdn=pdi>=0?store.dancers[pdi].name:'';
        if(store.isPlaying)showToast('\u5DF2\u5207\u5230\u300C\u6E38\u620F\u89D2\u8272\u300D\uFF1A\u7F51\u9875\u64AD\u653E\u7EE7\u7EED\uFF0C\u8981\u6E38\u620F\u5185\u64AD\u653E\u8BF7\u518D\u6309\u4E00\u6B21\u64AD\u653E\uFF08\u9884\u89C8\u821E\u8005\uFF1A'+pdn+'\uFF09');
        else showToast('\u5DF2\u5207\u5230\u300C\u6E38\u620F\u89D2\u8272\u300D\uFF1A\u62D6\u52A8\u548C\u64AD\u653E\u53EA\u9A71\u52A8\u6E38\u620F\u9884\u89C8\u821E\u8005\u300C'+pdn+'\u300D\uFF08\u6362\u4EBA\u70B9\u5404\u821E\u8005\u884C\u5934\u7684\uD83C\uDFAE \u9884\u89C8\uFF09');
      }
    });
  }else if(store.gameConnected){
    apiFetch('/playback/stop',{method:'POST'}).catch(function(){});
    apiFetch('/playback/freeze',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({command:''})}).catch(function(){});
    showToast('\u5DF2\u5207\u5230\u300C\u7F51\u9875 3D\u300D\uFF1A\u6E38\u620F\u89D2\u8272\u5DF2\u505C\u6B62\u5E76\u89E3\u51BB\uFF0C\u62D6\u52A8/\u64AD\u653E\u53EA\u8D70\u7F51\u9875');
  }else{
    showToast('\u5DF2\u5207\u5230\u300C\u7F51\u9875 3D\u300D\u6A21\u5F0F');
  }
}

function exportProject(){
  // WP-5-WIRE：导出文件就是规范演出文档（schemaVersion 2，稳定 ID/整数毫秒/未知键在 _extra）；
  // 旧 v5.0 导出文件的导入能力不受影响——导入端自动识别新旧两种形态
  var doc=projectRecord().content;
  var b=new Blob([JSON.stringify(doc,null,2)],{type:'application/json'});
  var u=URL.createObjectURL(b);var a=document.createElement('a');a.href=u;a.download='choreo_'+Date.now()+'.json';a.click();URL.revokeObjectURL(u);showToast('\u5DF2\u5BFC\u51FA');
}
// 导出所有舞者的宏文本为 .txt（含分页，可直接复制进游戏）
function exportMacroTxt(){
  var out=[];
  store.dancers.forEach(function(d,di){
    var lines=generateMacro(di);
    out.push('===== '+d.name+' =====');
    // 与界面一致：按页分块，页间空行分隔（/nextmacro 保留在页内）
    var page=[];
    lines.forEach(function(l){
      if(l==='/nextmacro'){page.push(l);out.push(page.join('\n'));page=[];out.push('')}
      else page.push(l)
    });
    if(page.length)out.push(page.join('\n'));
    out.push('');
  });
  if(store.globalLyrics.length){out.push('===== \u5168\u5C40\u6B4C\u8BCD =====');out.push(store.globalLyrics.map(function(c){return (c.start).toFixed(1)+'s  '+(c.data.name||'')}).join('\n'))}
  var b=new Blob([out.join('\n')],{type:'text/plain;charset=utf-8'});
  var u=URL.createObjectURL(b);var a=document.createElement('a');a.href=u;a.download='choreo_macro_'+Date.now()+'.txt';a.click();URL.revokeObjectURL(u);showToast('\u5B8F\u5DF2\u5BFC\u51FA .txt');
}
// AUD-002：导入层第二道防线——结构/类型/数量/长度/数值范围校验（渲染层按文本渲染仍是根本防线）
function sanitizeImportProject(data){
  if(!data||typeof data!=='object'||Array.isArray(data))throw new Error('文件不是有效的编舞工程 JSON');
  var dancers=data.dancers;
  if(!Array.isArray(dancers))throw new Error('缺少 dancers 数组');
  if(dancers.length<1||dancers.length>12)throw new Error('舞者数量须在 1～12 之间（当前 '+dancers.length+'）');
  function str(v,max,label){if(v==null)return;if(typeof v!=='string')throw new Error(label+' 必须是文本');if(v.length>max)throw new Error(label+' 超长（上限 '+max+' 字）')}
  function num(v,label){if(typeof v!=='number'||!isFinite(v))throw new Error(label+' 必须是数字');if(v<0||v>86400)throw new Error(label+' 超出允许范围（0～86400 秒）')}
  dancers.forEach(function(d,i){
    if(!d||typeof d!=='object'||Array.isArray(d))throw new Error('舞者 '+(i+1)+' 数据不完整');
    str(d.name,40,'舞者 '+(i+1)+' 名称');
    ['switchClips','actionClips','lyricClips','clips'].forEach(function(k){if(d[k]!==undefined&&!Array.isArray(d[k]))throw new Error('舞者 '+(i+1)+' 的 '+k+' 不是数组')});
    var clips=(d.actionClips||d.clips||[]).concat(d.switchClips||[],d.lyricClips||[]);
    if(clips.length>2000)throw new Error('舞者 '+(i+1)+' 的动作条太多（上限 2000）');
    clips.forEach(function(c,ci){
      if(!c||typeof c!=='object'||Array.isArray(c))throw new Error('舞者 '+(i+1)+' 第 '+(ci+1)+' 条数据不完整');
      if(c.data!==undefined&&(typeof c.data!=='object'||Array.isArray(c.data)))throw new Error('舞者 '+(i+1)+' 第 '+(ci+1)+' 条的 data 字段无效');
      str(c.data&&c.data.name,120,'舞者 '+(i+1)+' 第 '+(ci+1)+' 条的名称');
      str(c.data&&c.data.command,200,'舞者 '+(i+1)+' 第 '+(ci+1)+' 条的命令');
      num(c.start,'舞者 '+(i+1)+' 第 '+(ci+1)+' 条的开始时刻');
      num(c.duration,'舞者 '+(i+1)+' 第 '+(ci+1)+' 条的时长');
    });
  });
  if(data.globalLyrics!==undefined){
    if(!Array.isArray(data.globalLyrics))throw new Error('globalLyrics 不是数组');
    if(data.globalLyrics.length>5000)throw new Error('全局歌词行数太多（上限 5000）');
    data.globalLyrics.forEach(function(c,ci){
      if(!c||typeof c!=='object'||Array.isArray(c))throw new Error('全局歌词第 '+(ci+1)+' 行数据不完整');
      str(c.data&&c.data.name,500,'全局歌词第 '+(ci+1)+' 行文本');
      num(c.start,'全局歌词第 '+(ci+1)+' 行的开始时刻');
      num(c.duration,'全局歌词第 '+(ci+1)+' 行的时长');
    });
  }
  if(data.markers!==undefined){
    if(!Array.isArray(data.markers))throw new Error('markers 不是数组');
    if(data.markers.length>500)throw new Error('段落标记太多（上限 500）');
    data.markers.forEach(function(m,ci){
      if(!m||typeof m!=='object'||Array.isArray(m))throw new Error('段落标记第 '+(ci+1)+' 条数据不完整');
      str(m.name,60,'段落标记第 '+(ci+1)+' 条的名称');
      num(m.t,'段落标记第 '+(ci+1)+' 条的时刻');
    });
  }
  if(data.showLyricMacro!==undefined&&typeof data.showLyricMacro!=='boolean')throw new Error('showLyricMacro 必须是 true/false');
}
function importProject(data){
  // WP-5-WIRE：导入统一过文档模块（规范文档/旧 v5.0 文件自动识别），AUD-002 校验对投影统一执行；
  // clip 数值 id 来自文档迁移的保号投影（ev-<旧id>），不再按数组位置重编号——文件里的身份原样保留
  var w=ChoreoDocWire.importProjection(data,sanitizeImportProject);
  var proj=w.proj;
  clearClipSelection(); // WP-3 顺手修：导入前清掉选中引用，否则撤销后会指向已替换的旧数据
  store.dancers=proj.dancers;
  store.globalLyrics=proj.globalLyrics;
  store.showLyricMacro=!!proj.showLyricMacro;
  store.dancerCount=store.dancers.length;
  // WP-3b：段落标记（投影必带 markers）；A-B 循环随时间轴更换作废
  store.markers=proj.markers||[];
  store.contentExtra=ChoreoDocWire.unknownTopKeys(proj); // 文件里的未知顶层键随下一拍保存回文档 _extra
  store._docRev=w.rev; // 从文件携带的修订号起算（随后的 saveHistory 再递增）
  store.loopA=store.loopB=null;
  recalcNextClipId();
  store.dancers.forEach(function(d,i){autoFillGaps(i)}); // 导入后动作间空隙补齐
  repairClipNames(); // 导入数据同样做中文名修复（旧导出文件里的英文名）
  saveHistory();updateTotalDuration();render();showToast('\u5DF2\u5BFC\u5165');
}

// === RENDER ===
var detachMacroTa=null;
// OPT-2/AUD-019：clip.id → 该条的全部 DOM 节点数组（全局歌词一条两个 DOM），render() 重建时重填；
// 拖动中的局部刷新按它找到要改 left/width 的节点，不再整页重建
var _clipNodes={};
function render(){
  if(!store.appReady)return; // 阶段1：编辑器渲染只看网页程序就绪，不再被游戏连接挡住
  // OPT-2/AUD-018：内容版本号——3D 面板(preview3d.js)靠它感知时间轴变化，只有变了才重排引擎
  store._tlRev=(store._tlRev||0)+1;
  store._renderCount=(store._renderCount||0)+1; // OPT-2/AUD-019 诊断：完整重建次数（拖动中不应增长）
  // OPT-2/AUD-019：clip.id → DOM 节点表（拖动中局部刷新用），每次重建后重填
  _clipNodes={};
  var root=document.getElementById('root');
  // 2026-08-28：重建 DOM 前记住各滚动容器的位置，重建后恢复——加/删/改/拖任何动作
  // 都会整页重建，之前时间轴（横向 18000px）弹回最左、动作列表回顶部，看着就像"跳到开头"
  var _sc={};
  var _w0=document.getElementById('timelineWrap');
  if(_w0)_sc.tl=[_w0.scrollLeft,_w0.scrollTop];
  var _al0=document.querySelector('.act-list');if(_al0)_sc.al=_al0.scrollTop;
  var _tw0=document.querySelector('.tabs-wrap');if(_tw0)_sc.tw=_tw0.scrollTop;
  // 宏编辑中重建 DOM 会丢光标/撤销栈:先把焦点里的 textarea 摘下来,重建后复用
  var cur=document.activeElement;
  if(cur&&cur.classList&&cur.classList.contains('macro-tx')){
    detachMacroTa={node:cur,di:store.activeMacroTab,page:cur._pi,scroll:cur.scrollTop};
    cur.parentNode.removeChild(cur);
  }
  root.innerHTML='';
  root.appendChild(renderToolbar());
  var ws=el('div','workspace');
  ws.appendChild(renderSidebar());
  ws.appendChild(renderTimelineArea());
  root.appendChild(ws);
  root.appendChild(renderMacroPanel());
  root.appendChild(renderBottomBar());
  var ov=el('div','play-overlay');ov.id='playOverlay';
  if(!store.isPlaying)ov.style.display='none';
  root.appendChild(ov);
  renderRuler();updatePlayhead();updateTimeDisplay();
  // 滚动位置恢复（时间轴 + 底部标尺联动 + 侧栏列表/标签栏）
  var _w=document.getElementById('timelineWrap');
  if(_w&&_sc.tl){
    _w.scrollLeft=_sc.tl[0];_w.scrollTop=_sc.tl[1];
    var _br=document.getElementById('bottomRuler');if(_br)_br.scrollLeft=_w.scrollLeft;
  }
  var _al=document.querySelector('.act-list');if(_al&&_sc.al!=null)_al.scrollTop=_sc.al;
  var _tw=document.querySelector('.tabs-wrap');if(_tw&&_sc.tw!=null)_tw.scrollTop=_sc.tw;
  // 复用标记未消费(如切换了宏 tab)则丢弃
  if(detachMacroTa)detachMacroTa=null;
  // 宏编辑后重绘:文本未变则恢复光标,否则丢弃标记（按页定位对应文本框）
  if(macroCaretRestore){
    var mts=document.querySelectorAll('.macro-tx'),mta=null;
    mts.forEach(function(t){if(t._pi===macroCaretRestore.page)mta=t});
    if(mta&&mta.value===macroCaretRestore.text){
      var p=Math.min(macroCaretRestore.pos,mta.value.length);
      mta.setSelectionRange(p,p);
      mta.focus();
    }
    macroCaretRestore=null;
  }
  // AUD3-W1（FIX-H）：此调用原先缩进错位被关进上面的 macroCaretRestore 块——只有宏编辑触发的
  // 重绘才会恢复侧栏状态；普通重绘（加条/播放/吸附开关）后窄屏/分屏侧栏丢 open、遮罩卡住、
  // ☰ 要按两次。挪到 render() 尾部，每次重建 DOM 后都按 _sideOpen 复位
  _applySideOpen();
  // 实时体检：每次重绘后排一个防抖检查（编辑/拖动停稳 800ms 后真跑），并保持徽标同步
  scheduleRealtimeCheck();
  updateCheckBadge();
}

function renderToolbar(){
  var tb=el('div','toolbar');
  var pdi=gameActorIdx(),pdn=pdi>=0?store.dancers[pdi].name:''; // ACTOR：游戏模式提示当前预览舞者
  var brand=el('div','brand');
  brand.appendChild(el('span','logo','FF14'));
  brand.appendChild(el('span','sub','\u7F16\u821Ev5'));
  tb.appendChild(brand);
  // 阶段1（模式分流）：预览目标切换——网页 3D（默认）/ 游戏角色，决定拖动和播放发给谁
  var mt=el('button','btn'+(store.previewTarget==='game'?' active':''),store.previewTarget==='game'?'\uD83C\uDFAE \u6E38\u620F\u89D2\u8272':'\uD83C\uDF10 \u7F51\u9875 3D');
  mt.style.fontSize='10px';mt.style.padding='3px 6px';
  mt.title='\u9884\u89C8\u76EE\u6807\uFF1A\u65F6\u95F4\u8F74\u62D6\u52A8\u548C\u64AD\u653E\u53D1\u7ED9\u8C01\u3002\u300C\u7F51\u9875 3D\u300D\u53EA\u9A71\u52A8\u7F51\u9875\u6A21\u578B\uFF08\u6E38\u620F\u53EF\u4EE5\u5173\u7740\uFF09\uFF1B\u300C\u6E38\u620F\u89D2\u8272\u300D\u9A71\u52A8\u6E38\u620F\u5185\u89D2\u8272\uFF08\u9700\u6E38\u620F\u548C\u63D2\u4EF6\u5F00\u7740\uFF09';
  mt.onclick=switchPreviewTarget;
  tb.appendChild(mt);
  var bp=el('button','btn icon',store.isPlaying?'\u23F8':'\u25B6');bp.title='\u64AD\u653E(\u7A7A\u683C)\u2014\u2014\u5F53\u524D\uFF1A'+(store.previewTarget==='game'?('\u6E38\u620F\u5185\u64AD\u653E\uFF08\u9884\u89C8\u821E\u8005\uFF1A'+pdn+'\uFF09'):'\u7F51\u9875\u64AD\u653E');bp.onclick=togglePlay;
  tb.appendChild(bp);
  var bs=el('button','btn icon','\u23F9');bs.title='\u505C\u6B62';bs.onclick=stopPlay;tb.appendChild(bs);
  var td=el('span','time-disp');td.id='timeDisplay';td.textContent=fmtTime(store.currentTime);tb.appendChild(td);
  var sc=el('div','ctrl');sc.appendChild(el('label','','\u901F\u5EA6'));
  var sl=document.createElement('input');sl.type='range';sl.min='0.25';sl.max='2';sl.step='0.25';sl.value=store.speed;
  sl.onchange=function(e){var ns=parseFloat(e.target.value);if(store.isPlaying){var e2=(performance.now()-playStart)/1000*store.speed;playOffset=playOffset+e2;playStart=performance.now()}store.speed=ns};sc.appendChild(sl);
  sc.appendChild(el('span','',store.speed.toFixed(2)+'\u00D7'));tb.appendChild(sc);
  var dc=el('div','ctrl');dc.appendChild(el('label','','\u821E\u8005'));
  var dcg=el('div','dancer-sel');
  var snapBtn=el('button','btn'+(store.snapEnabled?' active':''),'\u21DD Snap');
  snapBtn.style.cssText='font-size:10px;padding:3px 6px';
  snapBtn.title='\u5438\u9644: \u62D6\u52A8\u65F6\u81EA\u52A8\u5BF9\u9F50\u5230\u6574\u79D2\u548C\u5176\u4ED6clip\u8FB9\u7F18';
  snapBtn.onclick=function(){store.snapEnabled=!store.snapEnabled;render()};
  tb.appendChild(snapBtn);
  var bsb=el('button','btn icon','\u2630');bsb.title='\u6536\u8D77/\u5C55\u5F00\u52A8\u4F5C\u9762\u677F';
  bsb.onclick=toggleSidebar;tb.appendChild(bsb);
  var bcp=el('button','btn'+(store.compact?' active':''),'\u25EB \u5206\u5C4F');bcp.style.fontSize='10px';bcp.style.padding='3px 6px';
  bcp.title='\u5206\u5C4F\u7D27\u51D1\u6A21\u5F0F\uFF1A\u52A8\u4F5C\u9762\u677F\u53D8\u6D6E\u7A97\uFF0C\u5DE5\u5177\u680F/\u65F6\u95F4\u8F74/\u8F68\u9053\u5168\u90E8\u538B\u7F29\uFF0C\u534A\u5C4F\u663E\u793A\u66F4\u8212\u670D';
  bcp.onclick=function(){store.compact=!store.compact;_compactTouched=true;try{localStorage.setItem('choreo_compact',store.compact?'1':'0')}catch(e){};applyCompact();render()};
  tb.appendChild(bcp);
  var brec=el('button','btn','⏺ 录制 3D 动作库');brec.style.fontSize='10px';brec.style.padding='3px 6px';
  brec.title='让游戏角色逐个表演动作，录进本机浏览器资料库（要开着游戏）：快速常用/完整全量/补缺失/自选四种，支持断点续录；录完网页 3D 立刻能用（完整全量约 1.5~2 小时）';
  brec.onclick=showRecModal;
  tb.appendChild(brec);
  var badv=el('button','btn','⋯ 高级');badv.id='advBtn';badv.style.fontSize='10px';badv.style.padding='3px 6px';
  badv.title='老版本功能收在这里：拍照精确模式、经典/增强引擎切换（日常编舞用不到）';
  badv.onclick=toggleAdvPop;
  tb.appendChild(badv);
  var b3d=el('button','btn','\uD83E\uDCCC 3D\u9884\u89C8');b3d.style.fontSize='10px';b3d.style.padding='3px 6px';
  b3d.title='打开 3D 预览面板：全部舞者真模型同屏，拖播放头/播放时同步摆姿势（需游戏开着，动作要在姿势预览页录制过）';
  b3d.onclick=function(){if(window.__togglePreview3D)window.__togglePreview3D();else showToast('3D 预览模块未加载')};
  tb.appendChild(b3d);
  var bprj=el('button','btn','\uD83D\uDCC1 项目');bprj.style.fontSize='10px';bprj.style.padding='3px 6px';
  bprj.title='项目中心：多个编舞分开管理（新建/打开/改名/复制/删除/历史版本）。自动保存不用手动存；老版本的草稿已经自动迁成了项目「我的编舞」';
  bprj.onclick=showProjectModal;
  tb.appendChild(bprj);
  var blib=el('button','btn','\uD83D\uDCE6 \u8D44\u6599\u5E93');blib.style.fontSize='10px';blib.style.padding='3px 6px';
  blib.title='本地 3D 资料库：把已录动作、骨架、模型存进本机浏览器，游戏关了网页也能离线播放；还能导出/导入备份';
  blib.onclick=showLibraryModal;
  tb.appendChild(blib);
  // WP-4：编舞体检——规则引擎在 web\choreo-check.js（纯函数、node 可测），这里只做入口
  // 实时体检：编辑后自动跑（见 runRealtimeCheck），按钮上的红/黄计数由 updateCheckBadge 维护
  var bchk=el('button','btn','\uD83E\uDE7A \u4F53\u68C0');bchk.style.fontSize='10px';bchk.style.padding='3px 6px';
  bchk.id='btnCheck';
  bchk.title='\u5B9E\u65F6\u4F53\u68C0\u5DF2\u5F00\uFF1A\u7F16\u8F91\u540E\u81EA\u52A8\u68C0\u67E5\uFF0C\u6709\u95EE\u9898\u7684\u52A8\u4F5C\u6761\u76F4\u63A5\u63CF\u7EA2/\u9EC4\u8FB9\u3002\u70B9\u5F00\u770B\u5B8C\u6574\u5217\u8868\uFF1A\u52A8\u4F5C\u7F3A\u5F55\u3001\u65F6\u957F\u8D85\u51FA\u6216\u5FAA\u73AF\u6CA1\u64AD\u6EE1\u3001\u59FF\u6001\u52A8\u4F5C\u540E\u89D2\u8272\u50F5\u4F4F\u3001\u52A8\u4F5C\u6761\u91CD\u53E0\u3001\u5B8F 0.5 \u79D2\u91CF\u5316\u6F02\u79FB\u3001\u8D44\u6599\u5E93\u9AA8\u67B6\u548C\u63D2\u4EF6\u80FD\u529B';
  bchk.onclick=showCheckModal;
  tb.appendChild(bchk);
  [1,2,3,4,5,6,7,8].forEach(function(n){var b=el('button','',String(n));if(store.dancerCount===n)b.classList.add('active');b.onclick=function(){setDancerCount(n)};dcg.appendChild(b)});
  dc.appendChild(dcg);tb.appendChild(dc);
  tb.appendChild(el('div','spacer'));
  var bl=el('button','btn','\u{1F3B5} \u6B4C\u8BCD');bl.onclick=function(){showLyricsModal()};tb.appendChild(bl);
  var be=el('button','btn','\u5BFC\u51FA');be.onclick=exportProject;tb.appendChild(be);
  var bt=el('button','btn hide-narrow', '\u5B8FTXT');bt.title='\u5BFC\u51FA\u6240\u6709\u821E\u8005\u7684\u5B8F\u6587\u672C\u4E3A .txt \u6587\u4EF6';bt.onclick=exportMacroTxt;tb.appendChild(bt);
  var bi=el('button','btn','\u5BFC\u5165');bi.onclick=function(){document.getElementById('fileInput').click()};tb.appendChild(bi);
  var fi=document.createElement('input');fi.type='file';fi.id='fileInput';fi.accept='.json';fi.style.display='none';
  fi.onchange=function(e){var f=e.target.files[0];if(!f)return;var r=new FileReader();r.onload=function(ev){try{importProject(JSON.parse(ev.target.result))}catch(err){showToast('导入失败：'+(err&&err.message?err.message:'文件格式不对'))}};r.readAsText(f);e.target.value=''};
  tb.appendChild(fi);
  var bc=el('button','btn danger','\u6E05\u7A7A');bc.onclick=function(){if(confirm('\u6E05\u7A7A\u6240\u6709\uFF1F')){store.dancers=[makeDancer(0)];store.globalLyrics=[];store.dancerCount=1;store.selectedClip=null;store.markers=[];store.loopA=store.loopB=null;saveHistory();updateTotalDuration();render()}};tb.appendChild(bc);
  var dot=el('span','dot '+(store.connected?'live':''));
  dot.title=store.connected?'\u6E38\u620F\u5DF2\u8FDE\u63A5':'\u6E38\u620F\u672A\u8FDE\u63A5\u2014\u2014\u70B9\u51FB\u91CD\u65B0\u68C0\u6D4B';
  dot.style.cursor='pointer';
  dot.onclick=function(){probeGame(false)};
  tb.appendChild(dot);
  return tb;
}

function renderSidebar(){
  var sb=el('div','sidebar');
  var s=el('div','search');
  var si=el('input','');si.type='text';si.placeholder='\u641C\u7D22...';si.value=store.search;
  si.oninput=function(e){store.search=e.target.value;var al=document.querySelector('.act-list');if(al){al.remove();sb.appendChild(renderActionList())}};
  s.appendChild(si);sb.appendChild(s);
  var tw=el('div','tabs-wrap');
  // Emote tabs
  tw.appendChild(el('div','tab-grp','\u60C5\u611F\u52A8\u4F5C'));
  var emoteTabs=[{key:'emote-usual',label:'\u901A\u5E38'},{key:'emote-special',label:'\u7279\u6B8A'},{key:'emote-expression',label:'\u8868\u60C5'}];
  emoteTabs.forEach(function(tc){
    var t=el('div','tab'+(store.activeTab===tc.key?' active':''));
    var cnt=store.emotes.filter(function(e){return e.category===tc.key.replace('emote-','')}).length;
    t.appendChild(document.createTextNode(tc.label));
    t.appendChild(el('span','badge',cnt));
    t.onclick=function(){store.activeTab=tc.key;render()};tw.appendChild(t);
  });
  // Skill by job - collapsible
  tw.appendChild(el('div','tab-grp','\u6280\u80FD (\u6309\u804C\u4E1A)'));
  var jobTabs=getJobTabs();
  // Show top 8 by default, rest hidden
  jobTabs.slice(0,20).forEach(function(j){
    var t=el('div','tab'+(store.activeTab===('job-'+j.name)?' active':''));
    t.appendChild(document.createTextNode(j.name)); // AUD-002：职业名来自目录数据，按文本渲染
    t.appendChild(el('span','badge',j.count));
    t.onclick=function(){store.activeTab='job-'+j.name;render()};tw.appendChild(t);
  });
  // Other
  tw.appendChild(el('div','tab-grp','\u5176\u4ED6'));
  var otherTabs=[{key:'skill-all',label:'\u5168\u90E8\u6280\u80FD'},{key:'switch',label:'\u5207\u6362'},{key:'race',label:'\u79CD\u65CF'},{key:'all',label:'\u5168\u90E8'}];
  otherTabs.forEach(function(tc){
    var t=el('div','tab'+(store.activeTab===tc.key?' active':''));
    var cnt=0;
    if(tc.key==='skill-all')cnt=store.actions.length;
    else if(tc.key==='switch')cnt=switchItems.length;
    else if(tc.key==='race')cnt=store.races.filter(function(r){return r.id>0}).length;
    else if(tc.key==='all')cnt=store.emotes.length+store.actions.length;
    t.appendChild(document.createTextNode(tc.label));
    t.appendChild(el('span','badge',cnt));
    t.onclick=function(){store.activeTab=tc.key;render()};tw.appendChild(t);
  });
  sb.appendChild(tw);
  sb.appendChild(renderActionList());
  return sb;
}

function renderActionList(){
  var items=getFilteredActions();
  var list=el('div','act-list');
  // MULTI-DANCER：添加到全部舞者（会话级开关，不进项目文件）——勾选后点动作/拖入动作轨给每位在场舞者同一时刻插入
  var allRow=el('label','add-all-row');
  allRow.style.cssText='display:flex;align-items:center;gap:6px;padding:6px 10px;font-size:11px;color:#9fb0c8;cursor:pointer;user-select:none';
  allRow.title='\u52FE\u9009\u540E\uFF1A\u70B9\u51FB\u4FA7\u680F\u52A8\u4F5C\u6216\u62D6\u5230\u52A8\u4F5C\u8F68\uFF0C\u4F1A\u7ED9\u6BCF\u4E00\u4F4D\u5728\u573A\u821E\u8005\u5728\u540C\u4E00\u65F6\u523B\u63D2\u5165\u8FD9\u6761\u52A8\u4F5C\uFF08\u5404\u81EA\u6309\u8F68\u9053\u89C4\u5219\u843D\u4F4D\uFF0C\u51B2\u7A81\u53EA\u987A\u5EF6\u81EA\u5DF1\uFF0C\u81EA\u52A8\u5207\u804C\u4E1A\u6309\u5404\u821E\u8005\u5F53\u524D\u804C\u4E1A\u5224\u65AD\uFF09\u3002\u4EC5\u672C\u6B21\u6253\u5F00\u6709\u6548\uFF0C\u4E0D\u968F\u9879\u76EE\u4FDD\u5B58';
  var allCb=document.createElement('input');allCb.type='checkbox';allCb.checked=!!store.addToAll;
  allCb.onchange=function(e){store.addToAll=!!e.target.checked;showToast(store.addToAll?'\u6DFB\u52A0\u5230\u5168\u90E8\u821E\u8005\uFF1A\u5F00\uFF08\u70B9\u52A8\u4F5C\u7ED9\u6BCF\u4F4D\u821E\u8005\u540C\u4E00\u65F6\u523B\u63D2\u5165\uFF09':'\u6DFB\u52A0\u5230\u5168\u90E8\u821E\u8005\uFF1A\u5173')};
  allRow.appendChild(allCb);
  allRow.appendChild(document.createTextNode('\u6DFB\u52A0\u5230\u5168\u90E8\u821E\u8005'));
  list.appendChild(allRow);
  if(!items.length){
    list.style.cssText='text-align:center;padding:16px;color:#7a8597;font-size:10px';
    list.textContent='\u65E0\u7ED3\u679C - \u70B9\u51FB\u4E0A\u65B9\u6807\u7B7E\u5207\u6362\u5206\u7C7B';
    return list;
  }
  var cols=el('div','act-cols');
  items.forEach(function(item){
    var ai=el('div','act-item');ai.draggable=true;
    ai.title=item.name+(item.jobAbbr?' ('+item.jobAbbr+')':'');
    ai.setAttribute('data-cat',item.category||'');
    ai.ondragstart=function(e){e.dataTransfer.setData('text/plain',JSON.stringify({data:item,fromSidebar:true}));e.currentTarget.classList.add('dragging')};
    ai.ondragend=function(e){e.currentTarget.classList.remove('dragging')};
  ai.onclick=function(){
    var di=store.selectedDancer;
    var track=(item.category==='switch')?'switch':'action';
    // Find end of last clip in this track to append after
    var d=store.dancers[di];
    if(!d){addClip(di,track,item);return}
    var arr=d[track+'Clips'];
    var lastEnd=0;
    arr.forEach(function(c){var e=c.start+c.duration;if(e>lastEnd)lastEnd=e});
    // MULTI-DANCER：开关开 + 动作 → 同一时刻插给每位在场舞者（切职业类条目保持单舞者口径）
    if(store.addToAll&&track==='action'){addClipToAllDancers(item,lastEnd);return}
    addClip(di,track,item,lastEnd);
  };
    ai.appendChild(el('div','ai-name',item.name));
    if(item.isLoop){
      ai.appendChild(el('div','ai-loop','\u221E \u5FAA\u73AF'));
    } else if(item.duration){
      ai.appendChild(el('div','ai-loop',(Math.round(item.duration*10)/10)+'s'));
    } else {
      // 非循环动作：显示实测真实时长（预览/播放过才有），否则标注待测
      var md=store.measuredDur[item.command];
      ai.appendChild(el('div','ai-loop',md?((Math.round(md*10)/10)+'s'):'\u975E\u5FAA\u73AF\u00B7\u70B9\u9884\u89C8\u6D4B\u65F6\u957F'));
    }
    if(item.jobAbbr){
      ai.appendChild(el('div','ai-job',item.jobAbbr));
    }
    cols.appendChild(ai);
  });
  list.appendChild(cols);
  return list;
}

var _mqJustDone=false; // 框选刚结束时为真：吞掉紧随的 click，避免框选完播放头乱跳
function renderTimelineArea(){
  var ta=el('div','tl-area');
  var tr=el('div','transport');
  var zc=el('div','ctrl');
  var zo=el('button','btn icon','-');zo.onclick=function(){store.pps=Math.max(10,store.pps/1.5);render()};zc.appendChild(zo);
  zc.appendChild(el('span','',store.pps+'px/s'));
  var zi=el('button','btn icon','+');zi.onclick=function(){store.pps=Math.min(200,store.pps*1.5);render()};zc.appendChild(zi);
  tr.appendChild(zc);
  tr.appendChild(el('span','\u603B:'));tr.appendChild(el('span','',store.totalDuration+'s'));
  var bAdd=el('button','btn','+1\u5206\u949F');bAdd.style.cssText='font-size:10px;padding:2px 6px';
  bAdd.title='\u8F68\u9053\u52A0\u957F60\u79D2\uFF08\u62D6\u52A8\u9499\u5236\u5728\u8F68\u9053\u672B\u7AEF\uFF0C\u9700\u8981\u66F4\u957F\u5C31\u70B9\u8FD9\u91CC\uFF09';
  bAdd.onclick=function(){store.totalDuration+=60;saveHistory();render();showToast('\u8F68\u9053\u5DF2\u52A0\u957F\u5230 '+store.totalDuration+' \u79D2')};
  tr.appendChild(bAdd);
  // WP-3b：A-B 循环（仅网页播放）+ 段落标记。游戏模式没有循环端点，A/B 禁用
  var gm=store.previewTarget==='game';
  var bLA=el('button','btn small'+(store.loopA!=null?' active':''),'A');bLA.style.cssText='font-size:10px;padding:2px 6px';
  bLA.title='在播放头设循环起点 A：网页播放只在 A~B 之间循环。游戏模式不支持（插件没有循环端点）';
  bLA.disabled=gm;bLA.onclick=function(){setLoopPoint('loopA')};tr.appendChild(bLA);
  var bLB=el('button','btn small'+(store.loopB!=null?' active':''),'B');bLB.style.cssText='font-size:10px;padding:2px 6px';
  bLB.title='在播放头设循环终点 B（A、B 谁在后自动当终点）';
  bLB.disabled=gm;bLB.onclick=function(){setLoopPoint('loopB')};tr.appendChild(bLB);
  var bLX=el('button','btn small','\u2715');bLX.style.cssText='font-size:10px;padding:2px 6px';
  bLX.title='清除 A-B 循环';
  bLX.disabled=gm;bLX.onclick=clearLoop;tr.appendChild(bLX);
  var bMk=el('button','btn small','\u2691+');bMk.style.cssText='font-size:10px;padding:2px 6px';
  bMk.title='在播放头添加段落标记（随项目保存）。标尺上旗标：点击跳转、右键改名/改时间/删除';
  bMk.onclick=addMarkerAtPlayhead;tr.appendChild(bMk);
  tr.appendChild(el('div','spacer'));
  if(store.selectedClip){
    var sc=store.selectedClip;
    var nsel=edSel().length;
    tr.appendChild(el('span','',(nsel>1?('已选 '+nsel+' 条 · '):'')+sc.data.name+' '+sc.start.toFixed(1)+'->'+(sc.start+sc.duration).toFixed(1)+' ('+sc.duration.toFixed(1)+'s)'));
    if(nsel>1)tr.appendChild(el('span','','Ctrl+点击加选 · 拖动整体平移 · Ctrl+C/V 复制粘贴'));
    var bd=el('button','btn danger',nsel>1?'删除所选':'\u5220\u9664');bd.onclick=deleteSelectedClips;tr.appendChild(bd);
  }else{
    tr.appendChild(el('span','\u672A\u9009\u4E2D'));
  }
  ta.appendChild(tr);
  var wrap=el('div','tl-wrap');wrap.id='timelineWrap';
  // Ctrl+滚轮：缩放时间轴密度（pps = 每秒像素）
  wrap.addEventListener('wheel',function(e){
    if(!e.ctrlKey)return;
    e.preventDefault();
    var old=store.pps;
    store.pps=Math.max(10,Math.min(240,old*(e.deltaY<0?1.15:1/1.15)));
    if(store.pps===old)return;
    // 以鼠标位置为锚点缩放：保持鼠标下的时间点不动
    var r=wrap.getBoundingClientRect();
    var mx=e.clientX-r.left+wrap.scrollLeft;
    var tAt=(mx-LABEL_W)/old;
    render();renderRuler();
    // render() 会整树重建 #timelineWrap，闭包里的 wrap 已是脱离文档的旧节点——
    // 锚点位置必须写进重新取到的新节点，否则缩放后时间轴弹回旧位置
    var nw=document.getElementById('timelineWrap');
    if(nw)nw.scrollLeft=LABEL_W+tAt*store.pps-(e.clientX-r.left);
    var br=document.getElementById('bottomRuler');if(br&&nw)br.scrollLeft=nw.scrollLeft;
    showToast('缩放: '+Math.round(store.pps)+' px/s');
  },{passive:false});
  // Click on empty area to move playhead
  wrap.onclick=function(e){
    if(_mqJustDone){_mqJustDone=false;return} // 框选刚结束：这次 click 不当"点空白定位"处理
    if(e.target.classList.contains('lane-body')||e.target.classList.contains('tl-canvas')||e.target.classList.contains('ruler')||e.target.classList.contains('bottom-ruler')){
      var r=wrap.getBoundingClientRect();
      var x=e.clientX-r.left+wrap.scrollLeft-LABEL_W;
      store.currentTime=Math.max(0,x/store.pps);
      updatePlayhead();updateTimeDisplay();
      sendSeek(store.currentTime); // WEB-RACE：显式跳播放头与标尺/标记/体检跳转一致，游戏模式下同样 seek
      var ph=document.getElementById('playhead');if(ph)ph.style.display='block';
      var br=document.getElementById('bottomRuler');if(br)br.scrollLeft=wrap.scrollLeft;
    }
  };
  // Sync scroll
  wrap.onscroll=function(){
    var br=document.getElementById('bottomRuler');if(br)br.scrollLeft=wrap.scrollLeft;
  };
  var canvas=el('div','tl-canvas');canvas.id='timelineCanvas';
  var ruler=el('div','ruler');ruler.id='ruler';canvas.appendChild(ruler);
  var lanes=el('div');lanes.id='lanes';
  var isSolo=store.dancerCount===1;
  var _cp=document.body.classList.contains('narrow');var laneHeight=isSolo?(_cp?44:56):(_cp?32:40);
  if(isSolo){var sp=el('div','');sp.style.height=laneHeight+'px';lanes.appendChild(sp)}
  store.dancers.forEach(function(d,di){
    var scale=d.laneScale||1;
    lanes.appendChild(renderDancerGroup(d,di,laneHeight*scale));
  });
  // Global lyric track at bottom
  lanes.appendChild(renderGlobalLyricTrack());
  canvas.appendChild(lanes);
  // WP-3b 框选：在轨道空白处（轨道体/顶标尺/画布空隙/**舞者标题行**/轨道标签）按下并拖动
  // ≥3px 画矩形，松手选中矩形碰到的所有动作条；拖不出死区的仍是普通点击，原行为不变。
  // 标题行里的按钮/输入框（S·M·+台词·折叠·轨道高度）不算起手，点它们照常工作。
  // 矩形挂 body（render() 重建不丢）；命中检测按屏幕矩形，折叠舞者轨道 0 尺寸自动跳过。
  // 时间轴区域已 user-select:none，拖动不会再触发浏览器的"选择/复制文字"。
  // 监听挂 canvas（标尺是 lanes 的兄弟节点）；closest 白名单放行刻度等子元素，动作条及其把手除外
  canvas.addEventListener('mousedown',function(e){
    if(e.button!==0)return;
    var tg=e.target;
    if(tg.closest&&(tg.closest('.clip')||tg.closest('.dh-right')||tg.closest('.gl-tg')||tg.closest('button')||tg.closest('input')))return; // 动作条/把手/标题行控件不做起手
    if(!(tg.closest&&(tg.closest('.lane-body')||tg.closest('.ruler')||tg.closest('.d-hdr')||tg.closest('.lane-label')||tg.closest('.gl-hdr'))||tg.classList.contains('tl-canvas')))return;
    var sx=e.clientX,sy=e.clientY,rect=null,cnt=null,mq=false,add=e.ctrlKey||e.metaKey;
    // 矩形命中检测（mv 实时计数和 up 落选共用）：返回碰到的 clip 对象数组（全局歌词按对象去重）
    var hits=function(l,t,r,b){
      var out=[],seen=[];
      Array.prototype.forEach.call(document.querySelectorAll('.clip'),function(node){
        var cr=node.getBoundingClientRect();
        if(cr.width<=0&&cr.height<=0)return; // 折叠舞者的轨道：跳过
        if(cr.right<l||cr.left>r||cr.bottom<t||cr.top>b)return;
        var c=node.__clip;if(!c||seen.indexOf(c)>=0)return;
        seen.push(c);out.push(c);
      });
      return out;
    };
    var mv=function(ev){
      if(!mq){
        if(Math.abs(ev.clientX-sx)<3&&Math.abs(ev.clientY-sy)<3)return;
        mq=true;
        try{window.getSelection().removeAllRanges()}catch(err){} // 保险：拖起来先清掉任何残留选区
        rect=document.createElement('div');
        rect.style.cssText='position:fixed;border:1px solid #7eb3ff;background:rgba(126,179,255,.15);pointer-events:none;z-index:9997;display:none';
        document.body.appendChild(rect);
        cnt=document.createElement('div'); // 实时显示框住的条数（2026-08-29 主人拍板的优化）
        cnt.style.cssText='position:fixed;z-index:9998;pointer-events:none;background:#161c26;border:1px solid #7eb3ff;border-radius:4px;padding:2px 8px;font-size:11px;color:#cfe0ff;white-space:nowrap;display:none';
        document.body.appendChild(cnt);
      }
      var l=Math.min(sx,ev.clientX),t=Math.min(sy,ev.clientY),r=Math.max(sx,ev.clientX),b=Math.max(sy,ev.clientY);
      rect.style.left=l+'px';rect.style.top=t+'px';
      rect.style.width=(r-l)+'px';rect.style.height=(b-t)+'px';
      rect.style.display='block';
      cnt.textContent=(add?'追加 ':'已选 ')+hits(l,t,r,b).length+' 条';
      cnt.style.left=(r+12)+'px';cnt.style.top=(t+12)+'px';
      cnt.style.display='block';
    };
    var up=function(ev){
      document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);
      if(rect)rect.remove();
      if(cnt)cnt.remove();
      if(!mq)return; // 没拖成=普通点击，交给原有 click 处理
      _mqJustDone=true;setTimeout(function(){_mqJustDone=false},0);
      var l=Math.min(sx,ev.clientX),t=Math.min(sy,ev.clientY),r=Math.max(sx,ev.clientX),b=Math.max(sy,ev.clientY);
      if(!add)clearClipSelection();
      var sel=hits(l,t,r,b);
      sel.forEach(function(c){c.selected=true});
      store.selectedClip=sel.length?sel[0]:null;
      render();
      if(sel.length)showToast('框选了 '+sel.length+' 条'+(add?'（追加模式）':''));
    };
    document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);
    e.preventDefault(); // 拖动时不选中文本
  });
  var ph=el('div','playhead');ph.id='playhead';ph.style.display='none';canvas.appendChild(ph);
  wrap.appendChild(canvas);
  ta.appendChild(wrap);
  // Bottom draggable timeline ruler
  var br=el('div','bottom-ruler');br.id='bottomRuler';
  br.style.cssText='height:64px;overflow-x:hidden;overflow-y:hidden;position:relative;border-top:1px solid var(--border);background:var(--panel);flex-shrink:0;cursor:pointer';
  br.innerHTML='<div id="bottomRulerInner" style="position:relative;height:100%;"></div>';
  br.onmousedown=function(e){
    // 拖动前先停掉本地播放循环：否则 rAF 每帧把 currentTime 拉回去，拖动和播放头互相打架
    if(store.isPlaying){
      playToken++;store.isPlaying=false;
      if(playRAF)cancelAnimationFrame(playRAF);
      if(store.previewTarget==='game')apiFetch('/playback/stop',{method:'POST'}).catch(function(){});
      var ov0=document.getElementById('playOverlay');if(ov0)ov0.style.display='none';
      render();
    }
    var r=br.getBoundingClientRect();
    var x=e.clientX-r.left+br.scrollLeft;
    store.currentTime=Math.max(0,(x-LABEL_W)/store.pps);
    updatePlayhead();updateTimeDisplay();
    sendSeek(store.currentTime);
    var ph=document.getElementById('playhead');if(ph)ph.style.display='block';
    // Drag to scrub - continuous seek for live preview
    var lastSent=0;
    var onMove=function(ev){
      var x2=ev.clientX-r.left+br.scrollLeft;
      store.currentTime=Math.max(0,(x2-LABEL_W)/store.pps);
      updatePlayhead();updateTimeDisplay();
      var now=Date.now();
      if(now-lastSent>50){lastSent=now;sendSeek(store.currentTime);}
    };
    var onUp=function(){
      sendSeek(store.currentTime);
      document.removeEventListener('mousemove',onMove);document.removeEventListener('mouseup',onUp)
    };
    document.addEventListener('mousemove',onMove);document.addEventListener('mouseup',onUp);
    e.preventDefault();
  };
  ta.appendChild(br);
  return ta;
}

function renderDancerGroup(dancer,di,lh){
  var group=el('div','dancer-grp'+(dancer.collapsed?' collapsed':''));
  var hdr=el('div','d-hdr');
  var dot=el('div','dh-dot');dot.style.background=dancer.color;hdr.appendChild(dot);
  hdr.appendChild(el('span','dh-nm',dancer.name));
  if(dancer.currentJob)hdr.appendChild(el('span','dh-jb','['+dancer.currentJob+']'));
  // ACTOR（2026-08-31）：游戏模式标出「游戏预览舞者」——播放/拖动只演这一位；
  // 点其他舞者行头的同一按钮换人（游戏连着且没在播时立即生效：推快照+按播放头重新定格）
  if(store.previewTarget==='game'){
    var bG=el('button','dh-sm'+(gameActorIdx()===di?' on':''),'\uD83C\uDFAE \u9884\u89C8');
    bG.title='游戏预览舞者：游戏模式播放/拖动只演这一位（游戏内只有一个角色；不受独奏/静音影响）。点其他舞者行头的同一按钮换人';
    bG.onclick=function(){setGameActor(di)};
    hdr.appendChild(bG);
  }
  // 右侧控件包成一组并 sticky 在屏幕右缘：横向拖动时间轴时按钮固定可见，不随内容滚走
  var rgt=el('div','dh-right');
  // MULTI-DANCER：整轨复制入口——点开列其他舞者，把那位的三条轨一次性复制给这位（class 独立于
  // dh-sm，clip-check 用 .dh-sm 下标选 S/M，别共用）
  if(store.dancers.length>1){
    var bCp=el('button','dh-copy','\u21C9');
    bCp.title='\u590D\u5236\u8F68\u9053\uFF1A\u628A\u5176\u4ED6\u821E\u8005\u7684\u4E09\u6761\u8F68\uFF08\u5207\u6362/\u52A8\u4F5C/\u53F0\u8BCD\uFF09\u4E00\u6B21\u6027\u590D\u5236\u7ED9\u8FD9\u4F4D\uFF0C\u5E26\u804C\u4E1A\u3001\u53D1\u65B0 id\uFF1B\u76EE\u6807\u5DF2\u6709\u5185\u5BB9\u65F6\u4F1A\u5148\u786E\u8BA4\uFF08\u6574\u4F53\u66FF\u6362\uFF0C\u4E00\u6B21\u64A4\u9500\u53EF\u8FD8\u539F\uFF09';
    bCp.style.cssText='font-size:11px;padding:2px 6px;margin-right:2px;background:#2c3440;color:#cdd6e4;border:1px solid #3d4757;border-radius:3px;cursor:pointer';
    bCp.onclick=function(e){e.stopPropagation(); // 冒泡会撞上 document 的全局 click 关菜单监听，先拦下
      var r=bCp.getBoundingClientRect();showCopyTracksMenu(r.left,r.bottom+2,di)};
    rgt.appendChild(bCp);
  }
  var rsz=el('div','dh-rsz');
  rsz.appendChild(el('label','','\u8F68\u9053\u9AD8\u5EA6'));
  var ri=document.createElement('input');ri.type='number';ri.min='0.5';ri.max='3';ri.step='0.5';ri.value=(dancer.laneScale||1);
  ri.onchange=function(e){dancer.laneScale=parseFloat(e.target.value)||1;saveHistory();render()};
  rsz.appendChild(ri);
  rgt.appendChild(rsz);
  // WP-3b：独奏(S)/静音(M)——随项目保存、同一舞者互斥（开一个自动关另一个）；
  // 生效口径见 ChoreoEdit.pure.isMuted（有人独奏=只有独奏者出动作）
  var bS=el('button','dh-sm'+(dancer.solo?' on':''),'S');bS.title='独奏：只让这个舞者出动作（可以多个独奏；和静音互斥）；再点取消';
  bS.onclick=function(){dancer.solo=!dancer.solo;if(dancer.solo)dancer.mute=false;saveHistory();render()};
  rgt.appendChild(bS);
  var bM=el('button','dh-sm'+(dancer.mute?' on':''),'M');bM.title='静音：这个舞者不出动作（网页 3D 站桩可见、游戏播放跳过；和独奏互斥）；再点取消';
  bM.onclick=function(){dancer.mute=!dancer.mute;if(dancer.mute)dancer.solo=false;saveHistory();render()};
  rgt.appendChild(bM);
  // Collapse toggle
  var addLy=el('button','btn','+ 台词');addLy.style.cssText='font-size:12px;padding:4px 10px;margin-right:6px;background:#5b8def;color:#fff;border:1px solid #4a7df0;border-radius:4px;cursor:pointer;white-space:nowrap'
  addLy.onclick=function(){var di2=di;var txt=prompt('\u8F93\u5165\u53F0\u8BCD\u6587\u5B57 (\u4EE5 / \u5F00\u5934\u5219\u4F5C\u4E3A\u547D\u4EE4, \u5982 /y \u4F60\u597D):');if(txt&&txt.trim()){var t2=txt.trim();var cmd2=t2.charAt(0)==='/'?t2:'/y '+t2;var d2=store.dancers[di2];var arr2=d2.lyricClips;var lastEnd2=0;arr2.forEach(function(c){var e2=c.start+c.duration;if(e2>lastEnd2)lastEnd2=e2});d2.lyricClips.push({id:store.nextClipId++,start:lastEnd2,duration:3,data:{name:t2,command:cmd2,category:'lyric',isLyric:true}});saveHistory();updateTotalDuration();render()}};
  rgt.appendChild(addLy);
  var tog=el('span','dh-toggle',dancer.collapsed?'\u25B6':'\u25BC');
  tog.onclick=function(){dancer.collapsed=!dancer.collapsed;render()};
  rgt.appendChild(tog);
  hdr.appendChild(rgt);
  group.appendChild(hdr);
  // Lanes
  var lanes=el('div','lanes');
  lanes.appendChild(renderLane(dancer,di,'switch','\u{1F504} \u5207\u6362',lh));
  lanes.appendChild(renderLane(dancer,di,'action','\u26A1 \u52A8\u4F5C',lh));
  lanes.appendChild(renderLane(dancer,di,'lyric','\u{1F4AC} \u53F0\u8BCD',Math.max(28,lh*0.7)));
  group.appendChild(lanes);
  return group;
}

function renderLane(dancer,di,trackType,labelText,lh){
  var cls=trackType==='switch'?'switch-lane':trackType==='action'?'action-lane':'lyric-lane';
  var lane=el('div','lane '+cls);
  if(edIsMuted(di))lane.classList.add('muted-lane'); // WP-3b：静音舞者的轨道整体调暗（模型站桩可见）
  lane.style.height=lh+'px';
  var label=el('div','lane-label');
  var parts=labelText.split(' ');
  label.appendChild(el('span','',parts[0]));
  label.appendChild(el('span','',parts[1]||''));
  lane.appendChild(label);
  var body=el('div','lane-body');
  body.ondragover=function(e){
    e.preventDefault();
    try{
      var data=JSON.parse(e.dataTransfer.getData('text/plain')||'{}');
      if(data.fromSidebar&&data.data){
        var r=e.currentTarget.getBoundingClientRect();
        var x=e.clientX-r.left;
        var st=x/store.pps;
        if(trackType!=='lyric'&&hasConflict(di,trackType,st,data.data.duration||3)){e.currentTarget.classList.add('conflict')}
        else{e.currentTarget.classList.add('drag-over')}
      }
    }catch(err){}
  };
  body.ondragleave=function(e){e.currentTarget.classList.remove('drag-over','conflict')};
  if(trackType==='lyric'){body.style.cursor='crosshair';body.onclick=function(e){
    if(e.target.closest('.clip'))return;
    if(_mqJustDone)return; // 框选刚结束的 click 不当"点空白输入台词"处理
    var r=e.currentTarget.getBoundingClientRect();
    var st=(e.clientX-r.left)/store.pps;
    var txt=prompt('\u8F93\u5165\u53F0\u8BCD:');
    if(txt&&txt.trim()){
      var ch=txt.trim().charAt(0);
      var prefix=ch==='/ '?'/':(ch==='/'?'':'/y ');
      var cmd=ch==='/'?txt.trim():'/y '+txt.trim();
      addClipToTrack(di,'lyric',{name:txt.trim(),command:cmd,category:'lyric',isLyric:true,duration:3},st);
    }
  }};
  body.ondrop=function(e){
    e.preventDefault();e.currentTarget.classList.remove('drag-over','conflict');
    try{
      var data=JSON.parse(e.dataTransfer.getData('text/plain'));
      if(data.fromSidebar&&data.data){
        var r=e.currentTarget.getBoundingClientRect();
        var x=e.clientX-r.left;
        var st=x/store.pps;
        if(trackType==='switch'&&data.data.category!==SWITCH_CAT){showToast('\u5207\u6362\u8F68\u9053\u53EA\u80FD\u653E\u5207\u6362\u7C7B');return}
        // MULTI-DANCER：开关开 + 动作轨 → 拖到哪一刻，全体舞者同一时刻插入（切职业条目保持单舞者口径）
        if(trackType==='action'&&store.addToAll)addClipToAllDancers(data.data,st);
        else addClip(di,trackType,data.data,st);
        // 松手即退出定格预览(若拖动期间停留在定格中)
        apiFetch('/playback/freeze',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({command:''})}).catch(function(){})
      }
    }catch(err){}
  };
  var clips=dancer[trackType+'Clips']||[];
  clips.forEach(function(c){body.appendChild(renderClip(c,di,trackType,lh))});
  lane.appendChild(body);
  return lane;
}

function renderGlobalLyricTrack(){
  var wrap=el('div','global-lyric');
  var hdr=el('div','gl-hdr');
  hdr.appendChild(el('span','gl-ttl','\u{1F3B5} \u5168\u5C40\u6B4C\u8BCD\u8F68 (\u5168\u821E\u8005\u5171\u4EAB)'));
  var tg=el('div','gl-tg');
  var cb=document.createElement('input');cb.type='checkbox';cb.checked=store.showLyricMacro;
  cb.onchange=function(e){store.showLyricMacro=e.target.checked;saveHistory();render()};
  tg.appendChild(cb);
  tg.appendChild(el('span','','\u5728\u5B8F\u4E2D\u663E\u793A\u539F\u6B4C\u8BCD'));
  hdr.appendChild(tg);
  wrap.appendChild(hdr);
  // 双行显示：上行原文，下行翻译（"原文 / 译文" 合并文本按首个 " / " 拆分；无翻译的行只显示在上行）
  var laneH2=document.body.classList.contains('narrow')?22:32;
  function glBody(){
    var body=el('div','lane-body');
    body.style.cursor='crosshair';
    body.ondragover=function(e){e.preventDefault();e.currentTarget.classList.add('drag-over')};
    body.ondragleave=function(e){e.currentTarget.classList.remove('drag-over')};
    return body;
  }
  function splitLyricText(name){
    var i=name.indexOf(' / ');
    return i>=0?[name.substring(0,i),name.substring(i+3)]:[name,null];
  }
  var laneO=el('div','lane lyric-lane');laneO.style.height=laneH2+'px';
  var labelO=el('div','lane-label');labelO.appendChild(el('span','','\u539F\u6587'));
  laneO.appendChild(labelO);
  var bodyO=glBody();
  var laneT=el('div','lane lyric-lane');laneT.style.height=laneH2+'px';
  var labelT=el('div','lane-label');labelT.appendChild(el('span','','\u8BD1\u6587'));
  laneT.appendChild(labelT);
  var bodyT=glBody();
  store.globalLyrics.forEach(function(c){
    var parts=splitLyricText(c.data.name||'');
    bodyO.appendChild(renderClip(c,-1,'lyric',laneH2,parts[0]));
    if(parts[1]!=null)bodyT.appendChild(renderClip(c,-1,'lyric',laneH2,parts[1]));
  });
  laneO.appendChild(bodyO);
  laneT.appendChild(bodyT);
  wrap.appendChild(laneO);
  wrap.appendChild(laneT);
  return wrap;
}

// 选中一个 clip（清掉其他选中态）——把手和条身两条路径共用
function selectClipOnly(clip){
  store.dancers.forEach(function(d){['switchClips','actionClips','lyricClips'].forEach(function(k){d[k].forEach(function(x){x.selected=false})})});
  store.globalLyrics.forEach(function(x){x.selected=false});
  clip.selected=true;store.selectedClip=clip;
}
function renderClip(clip,di,tt,lh,txtOverride){
  // 实时体检：该条有红/黄问题时描边（级别取最严重的；提示级不描边不吵）
  var _ilv=store.checkLevel&&store.checkLevel[clip.id];
  var c=el('div','clip'+(clip.selected?' selected':'')+(_ilv?(' issue-'+_ilv):''));
  c.setAttribute('data-cat',clip.data.category||'');
  c.style.left=(clip.start*store.pps)+'px';
  c.style.width=Math.max(20,clip.duration*store.pps)+'px';
  c.style.height=(lh-4)+'px';
  c.style.top='2px';
  // 拉长/缩短把手：真实元素命中（点中即拉长），不再按点击位置百分比猜意图——
  // 旧算法在窄动作条上判定区几乎占满整条，点哪儿都算拉长，误触极多
  var wpx=Math.max(20,clip.duration*store.pps);
  if(wpx>=48){
    var hdl=el('span','c-rz c-rz-l');hdl.title='左右拖：调整开始时刻（左端）';
    hdl.onmousedown=function(e2){e2.preventDefault();e2.stopPropagation();selectClipOnly(clip);dragClip(e2,clip,di,tt,'resize-left',clip.start);render()};
    c.appendChild(hdl);
  }
  var hdr=el('span','c-rz c-rz-r');hdr.title='左右拖：拉长/缩短时长';
  hdr.onmousedown=function(e2){e2.preventDefault();e2.stopPropagation();selectClipOnly(clip);dragClip(e2,clip,di,tt,'resize-right',clip.start+clip.duration);render()};
  c.appendChild(hdr);
  c.__clip=clip; // WP-3b 框选命中用：DOM 节点反查 clip 对象（render() 重建时一起重建，无悬挂问题）
  (_clipNodes[clip.id]=_clipNodes[clip.id]||[]).push(c); // OPT-2/AUD-019：拖动局部刷新用
  c.onmousedown=function(e){
    if(e.target.classList.contains('c-pv'))return;
    if(e.target.classList&&e.target.classList.contains('c-rz'))return; // 把手有自己的处理
    if(e.ctrlKey||e.metaKey){ // Ctrl+点击：加选/去选（不启动拖动）
      clip.selected=!clip.selected;
      store.selectedClip=clip.selected?clip:null;
      e.preventDefault();e.stopPropagation();render();return;
    }
    if(clip.selected&&edSel().length>1){store.selectedClip=clip} // 多选中拖其中一条=整体平移，选择集保持
    else selectClipOnly(clip);
    dragClip(e,clip,di,tt,'move',clip.start);
    e.preventDefault();e.stopPropagation();render();
  };
  c.oncontextmenu=function(e){e.preventDefault();showCtxMenu(e.clientX,e.clientY,clip,di,tt)};
  c.onmouseenter=function(e){showTip(e.clientX+10,e.clientY+10,clip.data.name+'\n'+(clip.data.command||'')+'\n'+clip.start.toFixed(1)+'s \xB7 '+clip.duration.toFixed(1)+'s')};
  c.onmouseleave=hideTip;
  if(clip.data.isLyric){
    c.appendChild(el('span','c-nm',txtOverride!=null?txtOverride:clip.data.name));
  }else{
    c.appendChild(el('span','c-nm',txtOverride!=null?txtOverride:clip.data.name));
    if(clip.data.command){
      var pv=el('button','c-pv','\u25B6');pv.title='\u9884\u89C8';pv.style.height=(lh-8)+'px';
      pv.onclick=function(e){e.stopPropagation();apiPreview(clip.data.command).then(function(r){showToast(r.status==='ok'?'\u9884\u89C8:'+clip.data.name:'\u5931\u8D25')}).catch(function(){showToast('\u5931\u8D25')})};
      c.appendChild(pv);
    }
    if(clip.data.jobAbbr){c.appendChild(el('span','c-job',clip.data.jobAbbr))}
  }
  return c;
}

// 拖动/拉长实时气泡：跟随鼠标显示当前值和新旧对比（拉长时一眼看到改了多少）
function updateDragTip(ev,type,clip,origStart,origDur){
  var tip=document.getElementById('dragTip');
  if(!ev){if(tip)tip.style.display='none';return} // 只隐藏
  if(!tip){
    tip=document.createElement('div');tip.id='dragTip';
    tip.style.cssText='position:fixed;display:none;z-index:9999;pointer-events:none;background:#161c26;border:1px solid var(--accent);border-radius:4px;padding:3px 8px;font-size:11px;color:#cfe0ff;white-space:nowrap';
    document.body.appendChild(tip);
  }
  var txt;
  if(type==='move')txt='\u5F00\u59CB '+clip.start.toFixed(1)+'s \u00B7 \u65F6\u957F '+clip.duration.toFixed(1)+'s';
  else if(type==='resize-left')txt='\u5F00\u59CB '+origStart.toFixed(1)+'\u2192'+clip.start.toFixed(1)+'s \u00B7 \u65F6\u957F '+origDur.toFixed(1)+'\u2192'+clip.duration.toFixed(1)+'s';
  else txt='\u65F6\u957F '+origDur.toFixed(1)+'\u2192'+clip.duration.toFixed(1)+'s';
  tip.textContent=txt;
  tip.style.left=Math.min(ev.clientX+14,window.innerWidth-170)+'px';
  tip.style.top=Math.max(6,ev.clientY-32)+'px';
  tip.style.display='block';
}
// 吸附对齐参考线：snapTime 真正吸附命中时显示一条竖线，未吸附隐藏
function updateDragGuide(t){
  var g=document.getElementById('dragGuide');
  if(t==null){if(g)g.style.display='none';return}
  var wrap=document.getElementById('timelineWrap');
  var lanes=document.getElementById('lanes');
  if(!wrap||!lanes){if(g)g.style.display='none';return}
  if(!g){
    g=document.createElement('div');g.id='dragGuide';
    g.style.cssText='position:fixed;width:1px;background:rgba(126,179,255,.8);pointer-events:none;z-index:9998;display:none';
    document.body.appendChild(g);
  }
  var wr=wrap.getBoundingClientRect(),lr=lanes.getBoundingClientRect();
  g.style.left=(wr.left+LABEL_W+t*store.pps-wrap.scrollLeft)+'px';
  g.style.top=lr.top+'px';g.style.height=lr.height+'px';g.style.display='block';
}
function dragClip(e,clip,di,tt,type,val){
  store._clipDragActive=true; // WEB-RACE：拖动中实时体检让路（防抖火灾/迟到结果都不重绘），收尾 render 再统一补最终检查
  var startX=e.clientX,startY=e.clientY;
  var raf=null,moved=false;
  var origStart=clip.start,origDur=clip.duration;
  // WP-3b 批量平移：拖的是多选集中的一条时，其余选中条按同一 delta 跟随（吸附/量化以被拖条为准）
  var group=null;
  if(type==='move'&&clip.selected&&edSel().length>1){
    group=edSel().map(function(s){return{c:s.clip,s0:s.clip.start}});
  }
  var onMove=function(ev){
    if(!moved){
      // 点击死区：位移<3px 视为纯点击选中——不改值、不重绘、不进历史，杜绝手抖误动
      if(Math.abs(ev.clientX-startX)<3&&Math.abs(ev.clientY-startY)<3)return;
      moved=true;
    }
    if(raf)return;
    var ev2=ev;
    raf=requestAnimationFrame(function(){
      raf=null;
      var dx=ev2.clientX-startX,dt=dx/store.pps,ns,snapped=null,tlChanged=false;
      if(type==='move'){
        ns=Math.max(0,val+dt);
        var pre=snapTime(ns,clip,di,tt,type);
        if(Math.abs(pre-ns)>0.001)snapped=pre; // 吸附命中（参考线挂这个时刻）
        ns=Math.round(pre*2)/2;
        if(group){ // AUD-008 整组平移：公共钳制一次、整组一起触边停，两两间距不变
          var applied=ChoreoEdit.pure.moveGroup(group,ns-clip.start,store.totalDuration);
          ns=clip.start+applied;
          tlChanged=applied!==0;
        }else{
          ns=Math.max(0,Math.min(ns,store.totalDuration-clip.duration)); // 轨道末端钳制：加长需点“+1分钟”
          if(ns!==clip.start){clip.start=ns;tlChanged=true}
        }
      }else if(type==='resize-left'){
        // HYGIENE(AC-5)：0.5s 最短时长钳制只发生在吸附之前——随后 snapTime 可把左缘吸附到
        // (end-0.5, end] 内的候选点上，实际时长被压到 0.5s 以下。这是既有行为，列为开放契约
        ns=Math.max(0,val+dt);var end=clip.start+clip.duration;ns=Math.min(ns,end-0.5);
        var pre2=snapTime(ns,clip,di,tt,type);
        if(Math.abs(pre2-ns)>0.001)snapped=pre2;ns=pre2;
        ns=Math.round(ns*2)/2;
        if(ns!==clip.start){clip.start=ns;clip.duration=end-ns;clip.autoDur=false;tlChanged=true}
      }else{
        var ne=Math.max(clip.start+0.5,val+dt);
        var pre3=snapTime(ne,clip,di,tt,type);
        if(Math.abs(pre3-ne)>0.001)snapped=pre3;ne=pre3;
        ne=Math.min(ne,store.totalDuration); // 末端钳制
        ne=Math.round(ne*2)/2;
        if(ne!==clip.start+clip.duration){clip.duration=ne-clip.start;clip.autoDur=false;tlChanged=true}
      }
      updateDragTip(ev2,type,clip,origStart,origDur);
      updateDragGuide(snapped);
      updateTotalDuration(); // 便宜（只算轨道末端），下一帧钳制要用最新值
      if(tlChanged){
        // OPT-2/AUD-018：拖动改变条目位置→ 3D 面板靠 _tlRev 感知并重排引擎时间轴
        store._tlRev=(store._tlRev||0)+1;
        // OPT-2/AUD-019：只改被拖条（多选=整组）的 left/width，不再每帧整页重建 DOM；
        // mouseup 才完整 render（描边/冲突高亮/持久化恢复），拖动全程跟手不打抖
        var pps=store.pps;
        (group||[{c:clip}]).forEach(function(it){
          var arr=_clipNodes[it.c.id];
          if(!arr)return;
          for(var i=0;i<arr.length;i++){
            var nd=arr[i];
            if(type==='move')nd.style.left=(it.c.start*pps)+'px';
            else if(type==='resize-left'){nd.style.left=(it.c.start*pps)+'px';nd.style.width=Math.max(20,it.c.duration*pps)+'px'}
            else nd.style.width=Math.max(20,it.c.duration*pps)+'px';
          }
        });
      }
    });
  };
  var onUp=function(){
    store._clipDragActive=false; // WEB-RACE：解除体检让路（本次 render 尾部会排最终检查）
    if(raf)cancelAnimationFrame(raf);
    updateDragTip(null); // 传 null 只隐藏
    updateDragGuide(null);
    if(moved){updateTotalDuration();saveHistory();render()} // OPT-2/AUD-019：收尾才整页重建+存历史（纯点击不进历史，选中 UI 在 mousedown 已 render）
    document.removeEventListener('mousemove',onMove);document.removeEventListener('mouseup',onUp);
  };
  document.addEventListener('mousemove',onMove);document.addEventListener('mouseup',onUp);
}

function showCtxMenu(x,y,clip,di,tt){
  var m=document.getElementById('ctxMenu');m.innerHTML='';
  if(!clip.selected)selectClipOnly(clip); // 右键的这条不在多选里就当单选处理（对齐/删除作用范围随之确定）
  var nsel=edSel().length;
  var items=[{act:'dup',label:'\u590D\u5236'},{sep:true},
    {act:'align',label:'\u5BF9\u9F50\u5230\u64AD\u653E\u5934'+(nsel>1?'\uFF08'+nsel+' \u6761\uFF09':''),title:'选中条起点统一=播放头（保持各自时长；跨舞者齐奏用）'},
    {act:'paste',label:'\u7C98\u8D34\u5230\u9009\u4E2D\u6761\u540E',title:'紧贴当前选中的那条之后粘贴（没选中则粘到播放头）',disabled:!store._clipboard||!store._clipboard.items.length},
    {act:'dur',label:'\u8BBE\u7F6E\u65F6\u957F...'},{act:'fill',label:'\u8865\u9F50\u7A7A\u9699(\u672C\u821E\u8005)',disabled:di<0},{act:'preview',label:'\u6E38\u620F\u5185\u9884\u89C8',disabled:!clip.data.command},{sep:true},{act:'del',label:nsel>1?('\u5220\u9664\u6240\u9009('+nsel+')'):'\u5220\u9664',danger:true}];
  items.forEach(function(it){
    if(it.sep){m.appendChild(el('div','ctx-sep'));return}
    if(it.disabled){var mi=el('div','ctx-it',it.label);mi.style.opacity='.4';m.appendChild(mi);return}
    mi=el('div','ctx-it'+(it.danger?' danger':''),it.label);
    if(it.title)mi.title=it.title;
    mi.onclick=function(){
      if(it.act==='dup')duplicateClip(clip);
      else if(it.act==='align')alignSelectionToPlayhead();
      else if(it.act==='paste')pasteSelection();
      else if(it.act==='dur'){var v=prompt('\u65F6\u957F(\u79D2)',clip.duration.toFixed(1));if(v){var d=Math.max(0.5,parseFloat(v)||0.5);if(tt!=='lyric'&&di>=0&&hasConflict(di,tt,clip.start,d,clip.id)){showToast('\u51B2\u7A81');return}clip.duration=d;clip.autoDur=false;saveHistory();updateTotalDuration();render()}}
      else if(it.act==='fill'){autoFillGaps(di);saveHistory();updateTotalDuration();render();showToast('\u5DF2\u8865\u9F50\u821E\u8005'+(di+1)+'\u52A8\u4F5C\u8F68\u7684\u7A7A\u9699')}
      else if(it.act==='preview')apiPreview(clip.data.command).then(function(r){showToast(r.status==='ok'?'\u9884\u89C8:'+clip.data.name:'\u5931\u8D25')}).catch(function(){showToast('\u5931\u8D25')});
      else if(it.act==='del')deleteSelectedClips();
      m.classList.remove('show');
    };
    m.appendChild(mi);
  });
  m.style.left=x+'px';m.style.top=y+'px';m.classList.add('show');
}
document.addEventListener('click',function(e){if(!e.target.closest('#ctxMenu'))document.getElementById('ctxMenu').classList.remove('show')});

function renderRuler(){
  var r=document.getElementById('ruler');if(!r)return;r.innerHTML='';
  // +40s 空白网格缓冲：轨道不在内容末尾"突然断轨"；拖片段进缓冲区时 totalDuration 自动生长
  var total=Math.max(store.totalDuration,30),pps=store.pps;
  var major=pps>=80?1:pps>=40?2:pps>=20?5:10;
  var minor=major/5;
  for(var t=0;t<=total;t+=minor){
    var tick=el('div','r-tick'+(t%major<0.01?' major':' minor'));
    tick.style.left=(LABEL_W+t*pps)+'px';r.appendChild(tick);
    if(t%major<0.01){var lb=el('div','r-lb',fmtDur(t));lb.style.left=(LABEL_W+t*pps)+'px';r.appendChild(lb)}
  }
  var c=document.getElementById('timelineCanvas');if(c)c.style.width=(LABEL_W+total*pps+80)+'px';
  // Render bottom ruler
  var bri=document.getElementById('bottomRulerInner');if(bri){
    bri.innerHTML='';bri.style.width=(LABEL_W+total*pps+80)+'px';
    for(var t2=0;t2<=total;t2+=minor){
      var bt=el('div','r-tick'+(t2%major<0.01?' major':' minor'));
      bt.style.left=(LABEL_W+t2*pps)+'px';bt.style.height='100%';bri.appendChild(bt);
      if(t2%major<0.01){var bl=el('div','r-lb',fmtDur(t2));bl.style.left=(LABEL_W+t2*pps)+'px';bl.style.bottom='6px';bri.appendChild(bl)}
    }
    // Bottom playhead marker
    var bpm=el('div','');bpm.id='bottomPlayhead';
    bpm.style.cssText='position:absolute;left:'+(LABEL_W+store.currentTime*pps)+'px;top:0;bottom:0;width:2px;background:var(--playhead);z-index:5;pointer-events:none';
    bri.appendChild(bpm);
  }
  // WP-3b：A-B 循环区间高亮 + 段落标记旗标（顶部/底部标尺都画；旗标只挂顶部，可交互）
  var hosts=[];
  var rTop=document.getElementById('ruler');if(rTop)hosts.push(rTop);
  var rBot=document.getElementById('bottomRulerInner');if(rBot)hosts.push(rBot);
  hosts.forEach(function(host,hi){
    if(store.loopA!=null&&store.loopB!=null){
      var l0=Math.min(store.loopA,store.loopB),l1=Math.max(store.loopA,store.loopB);
      var band=el('div','');
      band.style.cssText='position:absolute;top:0;bottom:0;background:rgba(126,179,255,.16);border-left:2px solid #7eb3ff;border-right:2px solid #7eb3ff;pointer-events:none;z-index:4';
      band.style.left=(LABEL_W+l0*pps)+'px';band.style.width=Math.max(2,(l1-l0)*pps)+'px';
      host.appendChild(band);
    }
    if(hi===0)(store.markers||[]).forEach(function(mk){
      var fl=el('div','mk-flag','\u2691'+(mk.name||''));
      fl.style.cssText='position:absolute;top:0;font-size:9px;color:#ffd27e;cursor:pointer;z-index:6;line-height:1.4;padding:0 2px;white-space:nowrap;text-shadow:0 1px 2px #000';
      fl.style.left=(LABEL_W+mk.t*pps)+'px';
      fl.title=(mk.name||'标记')+' @ '+mk.t.toFixed(1)+'s\n点击：跳到标记；右键：改名/改时间/删除';
      fl.onclick=function(ev){ev.stopPropagation();store.currentTime=Math.max(0,mk.t);updatePlayhead();updateTimeDisplay();sendSeek(store.currentTime)};
      fl.oncontextmenu=function(ev){ev.preventDefault();ev.stopPropagation();showMarkerMenu(ev.clientX,ev.clientY,mk)};
      host.appendChild(fl);
    });
  });
}

function renderMacroPanel(){
  var panel=el('div','macro-pnl'+(store.macroCollapsed?' collapsed':'')+(store.macroFullscreen?' fullscreen':''));
  // 高度由 inline height 直接驱动：旧版内容高度+max-height 方案下面板只有 ~140px，
  // 拖拽条改 maxHeight 视觉无效、全屏 max-height!important 也撑不开 —— 这就是"太低/全屏没反应"
  var normH=function(){return store.macroHeight||Math.max(280,Math.round(window.innerHeight*0.38))};
  var fsH=function(){return store.macroFsHeight||Math.round(window.innerHeight*0.86)};
  var applyH=function(){
    if(store.macroCollapsed)panel.style.height='26px';
    else if(store.macroFullscreen)panel.style.height=fsH()+'px';
    else panel.style.height=normH()+'px';
  };
  applyH();
  // 拖拽条：上下拖调整宏面板高度（普通/全屏各自记忆）
  var rz=el('div','macro-resize');rz.title='拖动调整宏面板高度';
  rz.onmousedown=function(e){
    e.preventDefault();e.stopPropagation();
    rz.classList.add('dragging');
    var sy=e.clientY,curH=panel.offsetHeight;
    var minH=140,maxH=store.macroFullscreen?window.innerHeight-60:window.innerHeight-200;
    var onMv=function(ev){
      var nh=Math.max(minH,Math.min(maxH,curH+(sy-ev.clientY)));
      panel.style.height=nh+'px';
      if(store.macroFullscreen)store.macroFsHeight=nh;else store.macroHeight=nh;
    };
    var onUp=function(){rz.classList.remove('dragging');document.removeEventListener('mousemove',onMv);document.removeEventListener('mouseup',onUp)};
    document.addEventListener('mousemove',onMv);document.addEventListener('mouseup',onUp);
  };
  panel.appendChild(rz);
  var hdr=el('div','macro-hdr');
  hdr.onclick=function(){store.macroCollapsed=!store.macroCollapsed;render()};
  hdr.appendChild(el('span','mp-ttl',store.macroCollapsed?'\u25B6 \u5B8F\u7F16\u8F91':'\u25BC \u5B8F\u7F16\u8F91'));
  var tabs=el('div','macro-tabs');
  store.dancers.forEach(function(d,di){
    var t=el('div','macro-tab'+(store.activeMacroTab===di?' active':''));t.textContent=d.name;
    t.onclick=function(e){e.stopPropagation();store.activeMacroTab=di;render()};tabs.appendChild(t);
  });
  hdr.appendChild(tabs);
  var fs=el('button','btn',store.macroFullscreen?'\u25A0 \u9000\u51FA\u5168\u5C4F':'\u26F6 \u5168\u5C4F');fs.title='\u5B8F\u9762\u677F\u5168\u5C4F\u7F16\u8F91\uFF08Esc \u9000\u51FA\uFF09';
  fs.onclick=function(e){e.stopPropagation();store.macroFullscreen=!store.macroFullscreen;render()};
  hdr.appendChild(fs);
  hdr.appendChild(el('span','','(\u7F16\u8F91\u540E\u81EA\u52A8\u540C\u6B65, \u81EA\u52A8\u63D2\u5165\u804C\u4E1A\u5207\u6362'+(store.showLyricMacro?', \u542B\u539F\u6B4C\u8BCD':'')+')'));
  panel.appendChild(hdr);
  if(!store.macroCollapsed){
    var body=el('div','macro-body');
    // 按 /nextmacro 把宏拆成多页，同屏分栏展示
    var full=generateMacro(store.activeMacroTab);
    var pages=[[]];
    full.forEach(function(l){if(l==='/nextmacro'){pages.push([])}else{pages[pages.length-1].push(l)}});
    var syncTimers={};
    pages.forEach(function(pl,pi){
      var pg=el('div','macro-page');
      var ph=el('div','macro-page-hdr');
      ph.appendChild(el('span','mph-tt','\u5B8F '+(pi+1)+'/'+pages.length+' \xB7 '+pl.length+' \u884C'));
      var cp=el('button','btn','\u590D\u5236\u672C\u9875');cp.title='\u590D\u5236\u5230\u526A\u8D34\u677F\uFF0C\u76F4\u63A5\u8D34\u8FDB\u6E38\u620F\u5B8F';
      cp.onclick=function(){
        navigator.clipboard.writeText(pl.join('\n')).then(function(){showToast('\u5B8F '+(pi+1)+' \u5DF2\u590D\u5236')}).catch(function(){showToast('\u590D\u5236\u5931\u8D25')});
      };
      ph.appendChild(cp);
      pg.appendChild(ph);
      // 复用焦点中的 textarea（保留光标/撤销栈/未同步输入）
      var ta=null;
      if(detachMacroTa&&detachMacroTa.di===store.activeMacroTab&&detachMacroTa.page===pi&&detachMacroTa.node.parentNode===null){
        ta=detachMacroTa.node;
      }
      if(!ta){
        ta=el('textarea','macro-tx');
        ta.value=pl.join('\n');
        ta.placeholder='\u5B8F\u6587\u672C - \u7F16\u8F91\u540E\u81EA\u52A8\u540C\u6B65\u5230\u8F68\u9053';
      }
      ta._pi=pi;
      ta.oninput=function(){
        pages[pi]=ta.value.split('\n');
        macroCaretRestore={di:store.activeMacroTab,page:pi,pos:ta.selectionStart,text:ta.value};
        var di=store.activeMacroTab; // WEB-RACE：输入那一刻的舞者身份定死，600ms 后火灾时 tab 可能已被切走
        clearTimeout(syncTimers[pi]);
        syncTimers[pi]=setTimeout(function(){
          var joined=[];
          pages.forEach(function(p,pp){if(pp>0)joined.push('/nextmacro');joined=joined.concat(p)});
          parseMacroToClips(joined.join('\n'),di);
        },600);
      };
      pg.appendChild(ta);
      body.appendChild(pg);
      if(detachMacroTa&&detachMacroTa.node===ta){
        try{ta.focus();var p2=Math.min(ta.selectionStart,ta.value.length);ta.setSelectionRange(p2,p2);}catch(e){}
        ta.scrollTop=detachMacroTa.scroll;
        detachMacroTa=null;
      }
    });
    panel.appendChild(body);
  }
  return panel;
}

function renderBottomBar(){
  var b=el('div','bottombar');
  var sc=0,ac=0,lc=0,glc=store.globalLyrics.length;
  store.dancers.forEach(function(d){sc+=d.switchClips.length;ac+=d.actionClips.length;lc+=d.lyricClips.length});
  // 引擎开关已移进工具栏「⋯ 高级」弹层（阶段4：普通用户不需要看见经典/增强内部概念）
  var pdi=gameActorIdx(),pdn=pdi>=0?store.dancers[pdi].name:'\u2014'; // ACTOR：底栏直接可见当前预览舞者
  var html='<div>\u6A21\u5F0F: <span class="v">'+(store.previewTarget==='game'?'\u6E38\u620F\u89D2\u8272':'\u7F51\u9875 3D')+'</span></div>'+
    '<div>\u9884\u89C8\u821E\u8005: <span class="v">'+(store.previewTarget==='game'?pdn:'\u2014')+'</span></div>'+
    '<div>\u6E38\u620F: <span class="v">'+(store.gameConnected?'\u5DF2\u8FDE\u63A5':'\u672A\u8FDE\u63A5')+'</span></div>'+
    '<div>\u821E\u8005: <span class="v">'+store.dancerCount+'</span></div>'+
    '<div>\u5207\u6362: <span class="v">'+sc+'</span></div>'+
    '<div>\u52A8\u4F5C: <span class="v">'+ac+'</span></div>'+
    '<div>\u6B4C\u8BCD: <span class="v">'+lc+'</span></div>'+
    '<div>\u5168\u5C40\u6B4C\u8BCD: <span class="v">'+glc+'</span></div>'+
    '<div id="recPos"></div>'+'<div id="cursorPos">位置: 0.0s</div>';
  b.innerHTML=html;
  return b;
}
