<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platform>x64</Platform>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ChoreoHelper</AssemblyName>
    <RootNamespace>ChoreoHelper</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>CS0436;CS8618;CS8601;CS8602;CS8603;CS8604;CS8625</NoWarn>
    <Version>0.7.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- tests 目录是独立工程（datalayertest.csproj），不编进插件 -->
    <Compile Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(AppData)\XIVLauncherCN\addon\Hooks\dev\Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud">
      <HintPath>$(AppData)\XIVLauncherCN\addon\Hooks\dev\Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Common">
      <HintPath>$(AppData)\XIVLauncherCN\addon\Hooks\dev\Dalamud.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(AppData)\XIVLauncherCN\addon\Hooks\dev\Lumina.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(AppData)\XIVLauncherCN\addon\Hooks\dev\Lumina.Excel.dll</HintPath>
      <Private>false</Private>
    </Reference>
      <Reference Include="InteropGenerator.Runtime">
      <HintPath>$(AppData)\XIVLauncherCN\addon\Hooks\dev\InteropGenerator.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(AppData)\XIVLauncherCN\addon\Hooks\dev\FFXIVClientStructs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyToDevPlugins" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <WebPages Include="..\web\dist\ChoreoHelper\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebPages)" DestinationFiles="@(WebPages->'$(AppData)\XIVLauncherCN\devPlugins\ChoreoHelper\dist\ChoreoHelper\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AppData)\XIVLauncherCN\devPlugins\ChoreoHelper\" />
    <Copy SourceFiles="$(TargetDir)plugin.json" DestinationFolder="$(AppData)\XIVLauncherCN\devPlugins\ChoreoHelper\" />
  </Target>
</Project>